@model QLBanDoAnNhanh.Models.GioHang

@{
    ViewData["Title"] = "Giỏ Hàng";
    var tongTien = Model.ChiTietGioHangs.Sum(x => x.TongTien);
    var tongSoLuong = Model.ChiTietGioHangs.Sum(x => x.SoLuongSp);
    var prefillUsername = ViewBag.PrefillUsername as string ?? "";
    var prefillPhone = ViewBag.PrefillPhone as string ?? "";
    var prefillAddress = ViewBag.PrefillAddress as string ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/foodfast-cart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/voucher.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/momo-payment.css" asp-append-version="true" />
}

<div class="cart-page">
    <div class="cart-page-inner">
        <h1 class="cart-title">Giỏ Hàng</h1>

        @if (Model.ChiTietGioHangs != null && Model.ChiTietGioHangs.Any())
        {
            <div class="cart-layout">
                <div class="cart-main">
                    @foreach (var item in Model.ChiTietGioHangs)
                    {
                        <div class="cart-product-card">
                            <div class="cart-product-image-wrap">
                                <img class="cart-product-image" src="@Url.Content(item.MaSpNavigation.HinhAnh1)" alt="@item.MaSpNavigation.TenSp" />
                            </div>

                            <div class="cart-product-info">
                                <h2 class="cart-product-name">@item.MaSpNavigation.TenSp</h2>

                                <div class="cart-product-badges">
                                    <span class="cart-badge">🚚 Free Delivery</span>
                                    <span class="cart-badge">⚡ Fast Prep</span>
                                </div>

                                <form asp-action="UpdateCart" method="post" class="update-form" id="update-form-@item.MaSp">
                                    <input type="hidden" name="MaSp" value="@item.MaSp" />
                                    <span class="cart-qty-label">Số lượng:</span>
                                    <div class="cart-qty-stepper">
                                        <button type="button" class="cart-qty-btn" aria-label="Giảm số lượng" onclick="var f=document.getElementById('update-form-@item.MaSp');var q=f.querySelector('input[name=quantity]');var v=parseInt(q.value)||1;if(v>1){q.value=v-1;f.submit();}">−</button>
                                        <input type="number" name="quantity" value="@item.SoLuongSp" min="1" />
                                        <button type="button" class="cart-qty-btn" aria-label="Tăng số lượng" onclick="var f=document.getElementById('update-form-@item.MaSp');var q=f.querySelector('input[name=quantity]');q.stepUp();f.submit();">+</button>
                                    </div>
                                    <button type="submit" class="btn-update-hidden">Cập nhật</button>
                                </form>
                            </div>

                            <div class="cart-product-price-col">
                                <div>
                                    <div class="cart-product-price">@String.Format("{0:0,0} VND", item.TongTien)</div>
                                    <div class="cart-product-unit-price">@String.Format("{0:0,0} VND", item.MaSpNavigation.GiaTien) / sp</div>
                                </div>
                                <a href="/GioHangs/RemoveFromCart?MaSp=@item.MaSp" class="cart-delete-link">🗑 Xóa</a>
                            </div>
                        </div>
                    }

                    <!-- Voucher Section -->
                    <div class="cart-voucher-card">
                        <h3 class="voucher-card-title">🎟️ Mã Giảm Giá</h3>
                        
                        <!-- Alert Container for Voucher -->
                        <div id="voucherAlertContainer" class="mb-3"></div>

                        <!-- Voucher Input Section -->
                        <div class="voucher-input-section mb-4">
                            <div class="input-group">
                                <input 
                                    type="text" 
                                    id="voucherCodeInput" 
                                    class="form-control" 
                                    placeholder="Nhập mã giảm giá"
                                    aria-label="Mã giảm giá" />
                                <button 
                                    class="btn btn-primary" 
                                    id="applyVoucherBtn" 
                                    type="button">
                                    <i class="fas fa-check"></i> Áp dụng
                                </button>
                            </div>
                            <small class="form-text text-muted d-block mt-2">
                                VD: FOOD10, FOOD20, VIP30
                            </small>
                        </div>

                        <!-- Applied Voucher Display -->
                        <div id="voucherSection" class="voucher-display mb-3 d-none">
                            <div class="voucher-badge">
                                <span class="voucher-code">Mã: <strong id="voucherCodeDisplay">--</strong></span>
                                <span class="voucher-percent">-<strong id="voucherPercentDisplay">0</strong>%</span>
                                <button 
                                    type="button" 
                                    id="removeVoucherBtn" 
                                    class="btn-remove-voucher"
                                    title="Xóa mã giảm giá">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                        <hr class="my-3" />
                    </div>

                    <div class="cart-summary-card">
                        <div class="cart-summary-rows">
                            <div class="cart-summary-row">
                                <span class="label">Tạm tính</span>
                                <span class="value" id="cartTotalAmount">@String.Format("{0:0,0} VND", tongTien)</span>
                            </div>
                            <div class="cart-summary-row">
                                <span class="label">Phí vận chuyển</span>
                                <span class="value" id="shippingFeeAmount">Chưa tính</span>
                            </div>
                            <div class="cart-summary-row">
                                <span class="label">Giảm giá</span>
                                <span class="value" id="discountAmount">0 VND</span>
                            </div>
                            <div class="cart-summary-row quantity-row">
                                <span class="label">Tổng số lượng</span>
                                <span class="value">@tongSoLuong</span>
                            </div>
                            <div class="cart-summary-row total">
                                <span class="label">Tổng thanh toán</span>
                                <span class="value" id="totalAfterDiscount">@String.Format("{0:0,0} VND", tongTien)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cart-sidebar">
                    <div class="checkout-card">
                        <h2 class="checkout-card-title">Thông Tin Thanh Toán</h2>
                        <form asp-action="Checkout" method="post" class="checkout-form" id="checkoutForm" data-initial-address="@prefillAddress">

                            @* Chi nhánh giao hàng *@
                            <div class="form-group" id="branchFormGroup">
                                <label for="chiNhanhSelect">Chi nhánh giao hàng</label>
                                <div class="checkout-select-wrap">
                                    
                                    <select id="chiNhanhSelect" class="checkout-select" aria-label="Chi nhánh giao hàng">
                                        <option value="">Chọn chi nhánh giao hàng</option>
                                    </select>
                                </div>
                                @* Thông tin chi nhánh đã chọn *@
                                <div id="branchInfo" class="branch-info-preview" hidden>
                                    <span class="branch-info-icon">🏪</span>
                                    <div class="branch-info-text">
                                        <strong id="branchInfoName"></strong>
                                        <small id="branchInfoAddress"></small>
                                        <small id="branchInfoDistance" class="branch-info-distance" style="color: #2563eb; font-weight: 600; display: block; margin-top: 4px;"></small>
                                    </div>
                                </div>
                                @* Cảnh báo hết hàng *@
                                <div id="branchStockAlert" class="branch-stock-alert" hidden role="alert">
                                    ⚠️ Một số sản phẩm không còn hàng tại chi nhánh này.
                                </div>
                            </div>
                            <input type="hidden" id="selectedChiNhanh" name="maChiNhanh" value="" />

                            <div class="form-group">
                                <label for="username">Họ tên</label>
                                <div class="checkout-input-wrap">
                                    <span class="checkout-input-icon">👤</span>
                                    <input type="text" class="form-control" id="username" name="username" value="@prefillUsername" required />
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="Phone">Số điện thoại</label>
                                <div class="checkout-input-wrap">
                                    <span class="checkout-input-icon">📞</span>
                                    <input type="text" class="form-control" id="Phone" name="Phone" value="@prefillPhone" required />
                                </div>
                            </div>

                            <div class="address-section">
                                <p class="address-section-title">📍 Địa chỉ giao hàng</p>

                                <div class="form-group">
                                    <label for="province">Tỉnh/Thành phố</label>
                                    <div class="checkout-select-wrap">
                                        <span class="checkout-input-icon">📍</span>
                                        <select id="province" class="checkout-select" aria-label="Tỉnh Thành phố">
                                            <option value="">Đang tải...</option>
                                        </select>
                                        <span class="select-loading" id="provinceLoading" aria-hidden="true"></span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="district">Quận/Huyện</label>
                                    <div class="checkout-select-wrap">
                                        <span class="checkout-input-icon">📍</span>
                                        <select id="district" class="checkout-select" disabled aria-label="Quận Huyện">
                                            <option value="">-- Chọn Quận/Huyện --</option>
                                        </select>
                                        <span class="select-loading" id="districtLoading" hidden aria-hidden="true"></span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="ward">Phường/Xã</label>
                                    <div class="checkout-select-wrap">
                                        <span class="checkout-input-icon">📍</span>
                                        <select id="ward" class="checkout-select" disabled aria-label="Phường Xã">
                                            <option value="">-- Chọn Phường/Xã --</option>
                                        </select>
                                        <span class="select-loading" id="wardLoading" hidden aria-hidden="true"></span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="streetAddress">Số nhà và tên đường</label>
                                    <div class="checkout-input-wrap">
                                        <span class="checkout-input-icon">🏠</span>
                                        <input type="text" class="form-control" id="streetAddress" placeholder="VD: 123 Nguyễn Văn Nghi" required />
                                    </div>
                                </div>

                                <input type="hidden" id="DiaChi" name="DiaChi" value="@prefillAddress" />

                                <div class="address-preview" id="addressPreview" hidden></div>
                                <div class="address-error" id="addressError" role="alert" hidden></div>

                                <button type="button" id="btnCalcShipping" class="btn btn-sm btn-outline-primary mt-2 w-100 fw-bold">
                                    <i class="fas fa-calculator me-1"></i> Tính phí vận chuyển theo vị trí
                                </button>
                            </div>

                            <div class="payment-method-section">
                                <p class="payment-method-title">Phương thức thanh toán</p>
                                <label class="payment-method-option is-selected">
                                    <input type="radio" name="paymentMethod" value="cod" checked />
                                    <span>Thanh toán khi nhận hàng (COD)</span>
                                </label>
                                <label class="payment-method-option">
                                    <input type="radio" name="paymentMethod" value="momo" />
                                    <span>Thanh toán MoMo QR</span>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-checkout">Thanh toán</button>
                            <button asp-action="CreatePayment" asp-controller="GioHangs" type="submit" class="btn btn-primary btn-paypal">
                                <span class="paypal-icon"><span class="pp-blue">Pay</span><span class="pp-light">Pal</span></span>
                            </button>
                            <input type="hidden" id="hiddenVoucherCode" name="voucherCode" value="" />
                            <input type="hidden" id="hiddenShippingFee" name="shippingFee" value="0" />
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="cart-empty">
                <div class="cart-empty-icon">🛒</div>
                <p>Giỏ hàng của bạn đang trống.</p>
                <a href="/SanPhams/TrangChu" class="btn-continue">Tiếp tục mua sắm</a>
            </div>
        }

        @if (Model.ChiTietGioHangs != null && Model.ChiTietGioHangs.Any())
        {
            <div class="cart-continue">
                <a href="/SanPhams/TrangChu" class="btn-continue">Tiếp tục mua sắm</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/cart-address.js" asp-append-version="true"></script>
    <script src="~/js/voucher.js" asp-append-version="true"></script>
    <script src="~/js/momo-payment.js" asp-append-version="true"></script>
    <script src="~/js/chi-nhanh-giao-hang.js" asp-append-version="true"></script>
    <script src="~/js/tinh-phi-giao-hang.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var diaChiInput = document.getElementById('DiaChi');
            var streetAddressInput = document.getElementById('streetAddress');
            var provinceSelect = document.getElementById('province');
            var districtSelect = document.getElementById('district');
            var wardSelect = document.getElementById('ward');
            var btnCalcShipping = document.getElementById('btnCalcShipping');
            var shippingFeeElement = document.getElementById('shippingFeeAmount');
            var totalAfterDiscountElement = document.getElementById('totalAfterDiscount');
            var cartTotalAmountElement = document.getElementById('cartTotalAmount');
            var discountAmountElement = document.getElementById('discountAmount');

            window.currentShippingFee = 0;

            // ---------------------------------------------------------------
            // Debounce + AbortController: đảm bảo chỉ 1 request được xử lý
            // ---------------------------------------------------------------
            var shippingDebounceTimer = null;
            var shippingAbortCtrl     = null;  // AbortController của request hiện tại
            var lastShippingAddress   = '';    // Địa chỉ lần tính trước (tránh tính lại nếu không đổi)

            function parseVnd(text) {
                if (!text) return 0;
                return parseInt(text.replace(/[^\d]/g, ''), 10) || 0;
            }

            function formatVnd(val) {
                return val.toLocaleString('vi-VN') + ' VND';
            }

            window.recalculateCartGrandTotal = function () {
                var subtotal = parseVnd(cartTotalAmountElement ? cartTotalAmountElement.textContent : '0');
                var discount = parseVnd(discountAmountElement ? discountAmountElement.textContent : '0');
                var shipping = window.currentShippingFee || 0;
                var grandTotal = Math.max(0, subtotal - discount + shipping);
                if (totalAfterDiscountElement) {
                    totalAfterDiscountElement.textContent = formatVnd(grandTotal);
                }
            };

            // Đọc trực tiếp từ dropdown + ô nhập, không phụ thuộc vào hidden #DiaChi
            function buildAddressFromInputs() {
                var province = provinceSelect && provinceSelect.selectedIndex > 0
                    ? provinceSelect.options[provinceSelect.selectedIndex].text : '';
                var district = districtSelect && districtSelect.selectedIndex > 0
                    ? districtSelect.options[districtSelect.selectedIndex].text : '';
                var ward = wardSelect && wardSelect.selectedIndex > 0
                    ? wardSelect.options[wardSelect.selectedIndex].text : '';
                var street = streetAddressInput ? streetAddressInput.value.trim() : '';
                return { province, district, ward, street };
            }

            // Kiểm tra thiếu trường nào, trả về thông báo cụ thể
            function getMissingFieldMessage(parts) {
                if (!parts.province) return 'Vui lòng chọn <strong>Tỉnh/Thành phố</strong>';
                if (!parts.district) return 'Vui lòng chọn <strong>Quận/Huyện</strong>';
                if (!parts.ward)     return 'Vui lòng chọn <strong>Phường/Xã</strong>';
                if (!parts.street)   return 'Vui lòng nhập <strong>Số nhà & Tên đường</strong>';
                return '';
            }

            // Hàm thực sự gọi API — chỉ được gọi sau khi debounce
            async function doCalculateShipping(fullAddress) {
                // Hủy request cũ nếu đang chạy
                if (shippingAbortCtrl) {
                    shippingAbortCtrl.abort();
                }
                shippingAbortCtrl = new AbortController();
                var signal = shippingAbortCtrl.signal;

                if (shippingFeeElement) {
                    shippingFeeElement.innerHTML = '<span class="text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Đang tính...</span>';
                }

                try {
                    var payload = { diaChiKhachHang: fullAddress };
                    // Nếu đã có tọa độ từ geolocation/autocomplete ở phía client thì gửi lên để backend bỏ qua bước geocode chuỗi.
                    if (window.userLocation && window.userLocation.lat != null && window.userLocation.lng != null) {
                        payload.latKhachHang = window.userLocation.lat;
                        payload.lngKhachHang = window.userLocation.lng;
                    }
                    // Gửi chi nhánh đang chọn để backend tính km/phí theo đúng chi nhánh đó.
                    var selectedBranchEl = document.getElementById('selectedChiNhanh');
                    if (selectedBranchEl && selectedBranchEl.value) {
                        var selectedBranchId = parseInt(selectedBranchEl.value, 10);
                        if (!isNaN(selectedBranchId) && selectedBranchId > 0) {
                            payload.MaChiNhanh = selectedBranchId;
                        }
                    }
                    var response = await fetch('/SanPhams/TinhPhiGiaoHang', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(payload),
                        signal: signal
                    });

                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    var res = await response.json();

                    if (res && res.success) {
                        window.currentShippingFee = res.phiGiaoHang;
                        if (res.latKhachHang != null && res.lngKhachHang != null) {
                            window.userLocation = { lat: res.latKhachHang, lng: res.lngKhachHang };
                        }
                        var hiddenShippingFee = document.getElementById('hiddenShippingFee');
                        if (hiddenShippingFee) hiddenShippingFee.value = res.phiGiaoHang;

                        if (shippingFeeElement) {
                            shippingFeeElement.innerHTML =
                                '<strong class="text-danger">' + res.phiGiaoHangFormatted + '</strong> ' +
                                '<small class="text-muted">(' + res.khoangCachKm + ' km | ' + res.thoiGianText + ')</small>';
                        }
                        window.recalculateCartGrandTotal();

                        // Tự động chọn chi nhánh gần nhất gợi ý
                        if (res.chiNhanhId) {
                            if (typeof window.updateCartBranchInfo === 'function') {
                                window.updateCartBranchInfo(res.chiNhanhId, res.khoangCachKm, res.thoiGianText);
                            } else {
                                var chiNhanhSelect = document.getElementById('chiNhanhSelect');
                                if (chiNhanhSelect) {
                                    chiNhanhSelect.value = res.chiNhanhId;
                                    chiNhanhSelect.dispatchEvent(new Event('change'));
                                }
                            }
                        }
                    } else {
                        console.warn('[TinhPhiGiaoHang Warning]:', res ? res.message : 'Unknown error');
                        window.currentShippingFee = 0;
                        var hiddenShippingFee = document.getElementById('hiddenShippingFee');
                        if (hiddenShippingFee) hiddenShippingFee.value = 0;
                        window.recalculateCartGrandTotal();
                        if (shippingFeeElement) {
                            var msg = (res && res.message) ? res.message : 'Lỗi tính phí';
                            shippingFeeElement.innerHTML =
                                '<span class="text-danger" style="font-size:0.85rem;" title="' + msg + '">' +
                                '<i class="fas fa-exclamation-triangle me-1"></i>' + msg + '</span>';
                        }
                    }
                } catch (err) {
                    if (err.name === 'AbortError') return; // Request bị hủy có chủ đích → bỏ qua
                    console.error('[TinhPhiGiaoHang Error]:', err);
                }
            }

            // Hàm gọi với debounce — đợi 600ms sau lần cuối cùng được gọi mới thực sự tính
            function triggerCalculateShipping(overrideAddr) {
                var fullAddress = '';

                if (overrideAddr) {
                    fullAddress = overrideAddr.trim();
                } else {
                    var parts = buildAddressFromInputs();
                    var missing = getMissingFieldMessage(parts);
                    if (missing) {
                        if (shippingFeeElement) {
                            shippingFeeElement.innerHTML = '<span class="text-warning" style="font-size:0.85rem;"><i class="fas fa-exclamation-circle me-1"></i>' + missing + '</span>';
                        }
                        return;
                    }
                    fullAddress = parts.street + ', ' + parts.ward + ', ' + parts.district + ', ' + parts.province;
                }

                if (!fullAddress || fullAddress.length < 5) return;

                // Nếu địa chỉ không đổi → không cần tính lại
                if (fullAddress === lastShippingAddress) return;
                lastShippingAddress = fullAddress;

                // Hủy timer debounce cũ (nếu có)
                if (shippingDebounceTimer) clearTimeout(shippingDebounceTimer);
                shippingDebounceTimer = setTimeout(function () {
                    doCalculateShipping(fullAddress);
                }, 600);
            }

            // Nút bấm tính phí trực tiếp → reset guard để tính lại dù địa chỉ không đổi
            if (btnCalcShipping) {
                btnCalcShipping.addEventListener('click', function () {
                    lastShippingAddress = ''; // Bắt buộc tính lại
                    triggerCalculateShipping();
                });
            }

            // Lắng nghe sự kiện addressChanged từ cart-address.js (khi đủ 4 trường)
            if (diaChiInput) {
                diaChiInput.addEventListener('addressChanged', function (e) {
                    if (e.detail && e.detail.trim().length > 5) {
                        triggerCalculateShipping(e.detail);
                    }
                });
            }

            // Khi rời ô số nhà & đường → tính phí (đọc thẳng từ dropdown)
            if (streetAddressInput) {
                streetAddressInput.addEventListener('blur', function () {
                    triggerCalculateShipping();
                });
            }

            // Nếu đã có sẵn địa chỉ đầy đủ từ ban đầu (prefill)
            setTimeout(function () {
                var initialAddr = (diaChiInput ? diaChiInput.value : '').trim();
                if (initialAddr && initialAddr.split(',').length >= 4) {
                    triggerCalculateShipping(initialAddr);
                }
            }, 900);
        });
    </script>

}
