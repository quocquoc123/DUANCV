@model QLBanDoAnNhanh.Models.DonHang

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
    var nguoiDung = Model.MaNguoiDungNavigation;
    var firstItem = Model.ChiTietDonHangs?.FirstOrDefault();
    var rebuyUrl = firstItem != null
        ? Url.Action("ChiTietSanPham", "SanPhams", new { id = firstItem.MaSp })
        : Url.Action("TrangChu", "SanPhams");
    var tamTinh = Model.ChiTietDonHangs?.Sum(x => x.TongTien) ?? Model.TongTien;
    var giamGiaVoucher = Math.Max(0, tamTinh - Model.TongTien);
    var thanhToan = Model.ThanhToans?.FirstOrDefault();
    var maVoucher = string.IsNullOrWhiteSpace(Model.MaKhuyenMai) ? "—" : Model.MaKhuyenMai;
    var phanTramVoucher = Model.MaKhuyenMaiNavigation?.GiaTri;

    string GetStatusClass(string trangThai)
    {
        var s = trangThai?.Trim() ?? "";
        if (s == "Đã Giao") return "status-delivered";
        if (s.Equals("Đang giao", StringComparison.OrdinalIgnoreCase) || s == "Đang Giao") return "status-shipping";
        if (s == "Đã Hủy") return "status-cancelled";
        return "status-pending";
    }

    string phuongThucThanhToan = thanhToan?.PhuongThucThanhToan;
    if (string.IsNullOrWhiteSpace(phuongThucThanhToan))
    {
        phuongThucThanhToan = "—";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/foodfast-order-history.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/foodfast-order-detail.css" asp-append-version="true" />
}

<div class="order-detail-page">
    <div class="order-detail-inner">
        <header class="order-detail-header">
            <h1>Chi Tiết Đơn Hàng</h1>
        </header>

        <div class="order-detail-layout">
            <div class="order-detail-main">
                <section class="detail-card">
                    <h2 class="detail-card-title">📋 Thông Tin Đơn Hàng</h2>
                    <div class="detail-info-grid">
                        <div class="detail-info-row">
                            <span class="label">Mã đơn hàng</span>
                            <span class="value">@Model.MaDh</span>
                        </div>
                        <div class="detail-info-row">
                            <span class="label">Ngày đặt hàng</span>
                            <span class="value">@(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                        </div>
                        <div class="detail-info-row">
                            <span class="label">Trạng thái</span>
                            <span class="value">
                                <span class="status-badge @GetStatusClass(Model.TrangThai)">@Model.TrangThai</span>
                            </span>
                        </div>
                        <div class="detail-info-row">
                            <span class="label">Phương thức thanh toán</span>
                            <span class="value">@phuongThucThanhToan</span>
                        </div>
                        <div class="detail-info-row">
                            <span class="label">Tổng tiền</span>
                            <span class="value highlight">@Model.TongTien.ToString("N0") VND</span>
                        </div>
                    </div>
                </section>

                <section class="detail-card">
                    <h2 class="detail-card-title">👤 Thông Tin Người Đặt</h2>
                    <div class="customer-info-list">
                        <div class="customer-info-item">
                            <div class="customer-info-icon">👤</div>
                            <div class="customer-info-text">
                                <div class="ci-label">Họ và tên</div>
                                <div class="ci-value">@(nguoiDung?.HoTen ?? Model.Username ?? "—")</div>
                            </div>
                        </div>
                        <div class="customer-info-item">
                            <div class="customer-info-icon">📞</div>
                            <div class="customer-info-text">
                                <div class="ci-label">Số điện thoại</div>
                                <div class="ci-value">@(nguoiDung?.Sdt ?? "—")</div>
                            </div>
                        </div>
                        <div class="customer-info-item">
                            <div class="customer-info-icon">✉️</div>
                            <div class="customer-info-text">
                                <div class="ci-label">Email</div>
                                <div class="ci-value">@(nguoiDung?.Email ?? "—")</div>
                            </div>
                        </div>
                        <div class="customer-info-item">
                            <div class="customer-info-icon">📍</div>
                            <div class="customer-info-text">
                                <div class="ci-label">Địa chỉ nhận hàng</div>
                                <div class="ci-value">@(string.IsNullOrWhiteSpace(Model.Diachi) ? "—" : Model.Diachi)</div>
                            </div>
                        </div>
                        <div class="customer-info-item">
                            <div class="customer-info-icon">📅</div>
                            <div class="customer-info-text">
                                <div class="ci-label">Ngày đặt đơn</div>
                                <div class="ci-value">@(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="detail-card product-list-card">
                    <h2 class="detail-card-title">🛒 Sản Phẩm Trong Đơn</h2>
                    <div class="product-detail-list">
                        @foreach (var chiTiet in Model.ChiTietDonHangs)
                        {
                            var sp = chiTiet.MaSpNavigation;
                            <div class="product-detail-item">
                                <div class="product-detail-img-wrap">
                                    @if (!string.IsNullOrEmpty(sp?.HinhAnh1))
                                    {
                                        <img src="@Url.Content(sp.HinhAnh1)" alt="@sp.TenSp" class="product-detail-img" />
                                    }
                                    else
                                    {
                                        <div class="order-card-image-placeholder" style="width:100%;height:100%;font-size:1.5rem;">🍔</div>
                                    }
                                </div>
                                <div class="product-detail-body">
                                    <div class="product-detail-name">@sp?.TenSp</div>
                                    <div class="product-detail-meta">
                                        <span>Giá: @sp?.GiaTien.ToString("N0") VND</span>
                                        <span>SL: @chiTiet.SoLuong</span>
                                    </div>
                                </div>
                                <div class="product-detail-line-total">@chiTiet.TongTien.ToString("N0") VND</div>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <aside class="order-detail-sidebar">
                <section class="detail-card">
                    <h2 class="detail-card-title">💳 Tổng Kết Thanh Toán</h2>
                    <div class="summary-rows">
                        <div class="summary-row">
                            <span class="sr-label">Tạm tính</span>
                            <span class="sr-value">@tamTinh.ToString("N0") VND</span>
                        </div>
                        <div class="summary-row">
                            <span class="sr-label">Phí giao hàng</span>
                            <span class="sr-value">Miễn phí</span>
                        </div>
                        <div class="summary-row">
                            <span class="sr-label">Phương thức thanh toán</span>
                            <span class="sr-value">@phuongThucThanhToan</span>
                        </div>
                        <div class="summary-row">
                            <span class="sr-label">Mã voucher</span>
                            <span class="sr-value">
                                @maVoucher
                                @if (phanTramVoucher.HasValue)
                                {
                                    <span>(-@phanTramVoucher.Value%)</span>
                                }
                            </span>
                        </div>
                        <div class="summary-row">
                            <span class="sr-label">Giảm giá voucher</span>
                            <span class="sr-value">-@giamGiaVoucher.ToString("N0") VND</span>
                        </div>
                        <div class="summary-row total">
                            <span class="sr-label">Tổng thanh toán</span>
                            <span class="sr-value">@Model.TongTien.ToString("N0") VND</span>
                        </div>
                    </div>
                </section>

                <section class="detail-card">
                    <h2 class="detail-card-title">⚡ Thao Tác</h2>
                    <div class="detail-actions">
                        <a href="@rebuyUrl" class="order-btn order-btn-rebuy">Mua Lại</a>
                        @if (Model.TrangThai != "Đã Hủy")
                        {
                            @if (Model.TrangThai == "Đã Giao")
                            {
                            }
                            @if (Model.TrangThai == "Đang giao")
                            {
                            }
                            else
                            {
                                <a href="@Url.Action("CancelOrder", "GioHangs", new { maDh = Model.MaDh })" class="order-btn order-btn-cancel" onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">Hủy Đơn</a>
                            }
                        }
                        <a href="@Url.Action("OrderHistory", "GioHangs")" class="order-btn order-btn-back">Quay Lại</a>
                    </div>
                </section>
            </aside>
        </div>
    </div>
</div>
