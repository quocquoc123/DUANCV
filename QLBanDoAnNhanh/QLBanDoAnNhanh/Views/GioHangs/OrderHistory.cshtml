@model IEnumerable<QLBanDoAnNhanh.Models.DonHang>

@{
    ViewData["Title"] = "Lịch Sử Đơn Hàng";
    var orderList = Model?.ToList() ?? new List<QLBanDoAnNhanh.Models.DonHang>();

    string GetStatusClass(string trangThai)
    {
        var s = trangThai?.Trim() ?? "";
        if (s == "Đã Giao") return "status-delivered";
        if (s.Equals("Đang giao", StringComparison.OrdinalIgnoreCase) || s == "Đang Giao") return "status-shipping";
        if (s == "Đã Hủy") return "status-cancelled";
        return "status-pending";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/foodfast-order-history.css" asp-append-version="true" />
}

<div class="order-history-page">
    <div class="order-history-inner">
        <header class="order-history-header">
            <h1><span class="title-icon" aria-hidden="true">📦</span> Lịch Sử Đơn Hàng</h1>
        </header>

        @if (!orderList.Any())
        {
            <div class="order-empty">
                <div class="order-empty-icon">📦</div>
                <h3>Bạn chưa có đơn hàng nào</h3>
                <p>Hãy khám phá các món ăn hấp dẫn và đặt đơn đầu tiên của bạn.</p>
                <a href="@Url.Action("TrangChu", "SanPhams")" class="btn-order-now">Đặt Món Ngay</a>
            </div>
        }
        else
        {
            <div class="order-grid">
                @foreach (var donHang in orderList)
                {
                    var firstItem = donHang.ChiTietDonHangs?.FirstOrDefault();
                    var productImage = firstItem?.MaSpNavigation?.HinhAnh1;
                    var rebuyUrl = firstItem != null
                        ? Url.Action("ChiTietSanPham", "SanPhams", new { id = firstItem.MaSp })
                        : Url.Action("TrangChu", "SanPhams");

                    <article class="order-card">
                        <div class="order-card-top">
                            <div class="order-card-image-wrap">
                                @if (!string.IsNullOrEmpty(productImage))
                                {
                                    <img src="@Url.Content(productImage)" alt="Sản phẩm đơn hàng" class="order-card-image" />
                                }
                                else
                                {
                                    <div class="order-card-image-placeholder">🍔</div>
                                }
                            </div>
                            <div class="order-card-info">
                                <div class="order-id">
                                    <span class="order-id-label">Mã đơn hàng</span>
                                    @donHang.MaDh
                                </div>
                                <div class="order-date">
                                    @(donHang.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </div>
                                <div class="order-total">@donHang.TongTien.ToString("N0") VND</div>
                            </div>
                        </div>

                        <div class="order-card-meta">
                            <span class="status-badge @GetStatusClass(donHang.TrangThai)">@donHang.TrangThai</span>
                        </div>

                        <div class="order-actions">
                            <a href="@Url.Action("OrderDetails", "GioHangs", new { maDh = donHang.MaDh })" class="order-btn order-btn-detail">Xem Chi Tiết</a>
                            <a href="@rebuyUrl" class="order-btn order-btn-rebuy">Mua Lại</a>
                            @if (donHang.TrangThai != "Đã Hủy")
                            {
                                @if (donHang.TrangThai == "Đã Giao")
                                {
                                }
                                @if (donHang.TrangThai == "Đang giao")
                                {
                                }
                                else
                                {
                                    <a href="@Url.Action("CancelOrder", "GioHangs", new { maDh = donHang.MaDh })" class="order-btn order-btn-cancel" onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?');">Hủy Đơn</a>
                                }
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>
