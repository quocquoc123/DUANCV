@model QLBanDoAnNhanh.Models.Banner

@{
    ViewData["Title"] = "Sửa Banner";
    Layout = "~/Views/Shared/_LayouAdmin.cshtml";
}

<div class="container-fluid mt-4" style="max-width:720px;">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a asp-action="AdminIndex" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <h1 class="mb-0"><i class="fas fa-edit text-warning"></i> Sửa Banner</h1>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaBanner" />
                <input type="hidden" asp-for="HinhAnh" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="TieuDe" class="form-label fw-semibold"></label>
                    <input asp-for="TieuDe" class="form-control" />
                    <span asp-validation-for="TieuDe" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Phạm vi hiển thị</label>
                        <select asp-for="MaDm" class="form-select" asp-items="ViewBag.DanhMucList">
                            <option value="">Trang chủ</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ViTri" class="form-label fw-semibold"></label>
                        <select asp-for="ViTri" class="form-select">
                            <option value="Left">Bên trái</option>
                            <option value="Right">Bên phải</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ThuTu" class="form-label fw-semibold"></label>
                        <input asp-for="ThuTu" type="number" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="TrangThai" class="form-check-input" type="checkbox" id="trangThaiSwitch" />
                            <label class="form-check-label fw-semibold" for="trangThaiSwitch">Đang hiển thị</label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Hình ảnh banner</label>
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <div class="mb-2">
                            <img src="@Model.HinhAnh" alt="@Model.TieuDe" id="imgPreview"
                                 class="rounded shadow-sm" style="max-height:200px;object-fit:cover;" />
                            <div class="form-text">Ảnh hiện tại. Chọn file mới bên dưới để thay thế.</div>
                        </div>
                    }
                    else
                    {
                        <img id="imgPreview" src="#" alt="Preview" class="rounded mb-2"
                             style="max-height:200px;display:none;" />
                    }
                    <input type="file" name="hinhAnhFile" class="form-control" accept="image/*"
                           onchange="previewImg(this)" />
                    <span asp-validation-for="HinhAnh" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save"></i> Lưu thay đổi
                    </button>
                    <a asp-action="AdminIndex" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImg(input) {
            const preview = document.getElementById('imgPreview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
