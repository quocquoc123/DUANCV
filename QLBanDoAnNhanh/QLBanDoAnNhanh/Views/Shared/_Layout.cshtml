    <script>
        function updateCartCount() {
            $.get("/GioHang/GetCartItemCount", function (data) {
                $("#cart-count").text(data);
            });
        }

        function updateWishlistBadge(count) {
            const badge = document.getElementById('wishlist-count-badge');
            if (!badge) return;
            if (count > 0) {
                badge.textContent = count;
                badge.style.display = 'block';
            } else {
                badge.style.display = 'none';
            }
        }

        function loadWishlistCount() {
            fetch('/Wishlist/Count')
                .then(r => r.json())
                .then(data => updateWishlistBadge(data.count))
                .catch(() => {});
        }

        $(document).ready(function () {
            updateCartCount();
            loadWishlistCount();
        });
    </script>
    <!-- ===== Branch Picker Script (chạy toàn site) ===== -->
    <script>
    (function () {
        'use strict';

        // ---- Constants ----
        const LS_KEY     = 'selectedBranchId';
        const LS_NAME    = 'selectedBranchName';
        const API_LIST   = '/ChiNhanh/GetDanhSachChiNhanh';
        const API_SET    = '/ChiNhanh/SetChiNhanh';

        // ---- State ----
        let allBranches  = [];     // cache danh sách từ API
        let selectedId   = null;   // MaChiNhanh đang chọn (null = tất cả)

        // ---- DOM ----
        const picker     = document.getElementById('branchPicker');
        const triggerBtn = document.getElementById('branchTriggerBtn');
        const label      = document.getElementById('branchLabel');
        const dropdown   = document.getElementById('branchDropdown');
        const list       = document.getElementById('branchList');
        const searchInput = document.getElementById('branchSearchInput');

        if (!picker || !triggerBtn) return; // Guard: không phải trang có layout này

        // ---- Helpers ----
        function setLabel(name) {
            label.textContent = name || 'Chọn chi nhánh';
        }

        function openPicker() {
            picker.classList.add('open');
            triggerBtn.setAttribute('aria-expanded', 'true');
            if (searchInput) { searchInput.value = ''; renderList(allBranches); searchInput.focus(); }
        }

        function closePicker() {
            picker.classList.remove('open');
            triggerBtn.setAttribute('aria-expanded', 'false');
        }

        function togglePicker() {
            picker.classList.contains('open') ? closePicker() : openPicker();
        }

        // ---- Render branch list ----
        function renderList(branches) {
            if (!list) return;

            list.innerHTML = '';

            // Option reset "Tất cả chi nhánh"
            const resetLi = document.createElement('li');
            resetLi.className = 'branch-item-reset' + (selectedId === null ? ' active' : '');
            resetLi.innerHTML = `<span>🌐</span> Tất cả chi nhánh`;
            resetLi.addEventListener('click', () => selectBranch(null, 'Chọn chi nhánh'));
            list.appendChild(resetLi);

            if (branches.length === 0) {
                const empty = document.createElement('li');
                empty.className = 'branch-list-empty';
                empty.textContent = 'Không tìm thấy chi nhánh nào.';
                list.appendChild(empty);
                return;
            }

            branches.forEach(cn => {
                const li = document.createElement('li');
                li.className = 'branch-item' + (selectedId === cn.id ? ' active' : '');
                li.setAttribute('role', 'option');
                li.setAttribute('data-id', cn.id);
                li.setAttribute('aria-selected', selectedId === cn.id ? 'true' : 'false');

                const statusClass = cn.isOpen ? 'open' : 'closed';
                const statusText  = cn.isOpen ? 'Đang mở' : 'Đã đóng';

                li.innerHTML = `
                    <span class="branch-item-icon">📍</span>
                    <div class="branch-item-info">
                        <div class="branch-item-name">${escapeHtml(cn.tenChiNhanh)}</div>
                        <div class="branch-item-address">${escapeHtml(cn.diaChi)}</div>
                        <div class="branch-item-hours">⏰ ${escapeHtml(cn.gioMoCua)} – ${escapeHtml(cn.gioDongCua)}</div>
                    </div>
                    <span class="branch-status-badge ${statusClass}">${statusText}</span>
                    <svg class="branch-item-check" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>`;

                li.addEventListener('click', () => selectBranch(cn.id, cn.tenChiNhanh));
                list.appendChild(li);
            });
        }

        // ---- Escape HTML helper ----
        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // ---- Select a branch ----
        function selectBranch(id, name) {
            selectedId = id;

            // Update localStorage
            if (id) {
                localStorage.setItem(LS_KEY,  String(id));
                localStorage.setItem(LS_NAME, name);
            } else {
                localStorage.removeItem(LS_KEY);
                localStorage.removeItem(LS_NAME);
            }

            // Update label
            setLabel(id ? '📍 ' + name : 'Chọn chi nhánh');

            // POST lên server để lưu Session
            fetch(API_SET, {
                method : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body   : JSON.stringify({ maChiNhanh: id || 0 })
            }).catch(() => {});

            // Dispatch event cho TrangChu.cshtml lắng nghe
            document.dispatchEvent(new CustomEvent('branchChanged', {
                detail: { id: id, name: name }
            }));

            closePicker();
        }

        // ---- Load branches from API ----
        async function loadBranches() {
            try {
                const res  = await fetch(API_LIST);
                allBranches = await res.json();
                renderList(allBranches);
            } catch (err) {
                if (list) {
                    list.innerHTML = '<li class="branch-list-empty">⚠️ Không tải được danh sách chi nhánh.</li>';
                }
            }
        }

        // ---- Search filter ----
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const kw = this.value.trim().toLowerCase();
                if (!kw) { renderList(allBranches); return; }
                const filtered = allBranches.filter(cn =>
                    cn.tenChiNhanh.toLowerCase().includes(kw) ||
                    cn.diaChi.toLowerCase().includes(kw)
                );
                renderList(filtered);
            });

            // Prevent dropdown closing when typing in search
            searchInput.addEventListener('click', e => e.stopPropagation());
        }

        // ---- Toggle on trigger click ----
        triggerBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            togglePicker();
            // Load lazy khi mở lần đầu
            if (picker.classList.contains('open') && allBranches.length === 0) {
                loadBranches();
            }
        });

        // ---- Close when clicking outside ----
        document.addEventListener('click', function (e) {
            if (!picker.contains(e.target)) closePicker();
        });

        // ---- Close on Escape ----
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closePicker();
        });

        // ---- Restore from localStorage on page load ----
        (function restoreState() {
            const savedId   = localStorage.getItem(LS_KEY);
            const savedName = localStorage.getItem(LS_NAME);
            if (savedId && savedName) {
                selectedId = parseInt(savedId, 10);
                setLabel('📍 ' + savedName);

                // Đồng bộ Session về phía server (silent)
                fetch(API_SET, {
                    method : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body   : JSON.stringify({ maChiNhanh: selectedId })
                }).catch(() => {});
            }
        })();

    })();
    </script>

    <script src="~/js/add-to-cart.js" asp-append-version="true"></script>

