<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Website bán đồ ăn</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/foodfast-layout.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.13/signalr.min.js"></script>
</head>
@RenderSection("Scripts", required: false)
<body>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    <header class="site-header">
        <div class="header-inner">
            <div class="top-bar">
                <div class="top-left">
                    <span class="contact">Zalo 0123244566</span>
                    <span class="header-badge" aria-label="Giao nhanh trong 30 phút">
                        <span class="badge-icon">⚡</span> Giao nhanh 30p
                    </span>
                </div>
                <div class="account-lang">

                    <a style="padding-left:15px">

                        @*  @if (Session["Email"] == null)
                    { *@
                        @*  @Html.ActionLink("Tài Khoản", "Index", "LoginUser") *@
                    @* } *@
                        @*  else
                    {
                        <a href="@Url.Action("UserDetails", "LoginUser")"><text>Hello</text> @Session["Email"]</a>
                        <span style="padding-left:15px">@Html.ActionLink("Đăng Xuất", "LogOutUser", "LoginUser")</span>
                    } *@
                    </a>
                    <div style="position: relative; display: inline-block;">
                        <a href="@Url.Action("Index", "GioHangs")">
                            <img src="@Url.Content("~/images/cart.jpg")" id="cart" height="30" width="30" />
                            <span class="cart-count" style="position: absolute; top: -8px; right: -20px; background-color: red; color: white; border-radius: 50%; padding: 3px;">
                                @(Context.Session.GetInt32("CartItemCount") ?? 0)
                            </span>
                        </a>

                    </div>
                    <div class="dropdown">
                        <a style="margin-left:30px" href="/user/Profile">
                            <img src="/images/acount.png" alt="Đăng nhập" style="height: 30px; width: 30px;">
                        </a>
                        <div class="order-history">
                            <a href="@Url.Action("OrderHistory", "GioHangs")">Lịch Sử Đơn Hàng</a>
                            <a href="@Url.Action("DangXuat", "User")">Đăng Xuất</a>

                        </div>
                    </div>

                </div>
            </div>
            <div class="logo-search">
                <a href="@Url.Action("TrangChu", "SanPhams")" class="brand">
                    <img src="~/images/logo.jpg" alt="Foot Store Logo" class="logo">
                    <div class="brand-meta">
                        <div class="brand-title">Food Fast</div>
                        <div class="brand-subtitle">Ăn nhanh - Giao gọn</div>
                    </div>
                </a>
                <nav>
                    <ul>
                        <li><a href="@Url.Action("TrangChu", "SanPhams")">Trang chủ</a></li>
                        <li><a href="@Url.Action("SanPhamTheoTenDanhMuc", "SanPhams", new { TenHang = "THUCDON" }, null)">Thực đơn</a></li>
                        <li><a href="@Url.Action("SanPhamTheoTenDanhMuc", "SanPhams", new { TenHang = "NUOCUONG" }, null)">Nước uống</a></li>
                        <li><a href="@Url.Action("SanPhamTheoTenDanhMuc", "SanPhams", new { TenHang = "BESTSELLER" }, null)">Best seller</a></li>
                        <li><a href="@Url.Action("SanPhamTheoTenDanhMuc", "SanPhams", new { TenHang = "KHUYENMAI" }, null)">Khuyến mãi</a></li>
                        <li><a href="@Url.Action("SanPhamTheoTenDanhMuc", "SanPhams", new { TenHang = "DOANCAY" }, null)">Đồ ăn cay</a></li>
                    </ul>
                </nav>
                <div class="col-6 text-right">
                    <form method="GET" action="@Url.Action("Search", "SanPhams")" class="form-inline d-inline-block">
                        <input type="text" class="form-control" id="searchTerm" name="searchTerm" placeholder="Tìm kiếm sản phẩm">
                        <button class="btn btn-primary" id="searchButton" type="submit">
                            <i class="fas fa-search"></i> Tìm kiếm
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <div>
        @RenderBody()
    </div>
    <div id="chatBubble" onclick="toggleChat()">
        <a asp-controller="BaoCaoUser" asp-action="SubmitFeedback">
        <img src="~/images/chattt.jpg" alt="Chat Icon" />
    </a>
    </div>
    <footer class="footer">
        <div class="container">
            <div class="row">
                <!-- Danh Mục Món Ăn -->
                <div class="col-md-3">
                    <h5>Danh Mục Món Ăn</h5>
                    <ul>
                        <li><a href="#">Ưu Đãi</a></li>
                        <li><a href="#">Món Mới</a></li>
                        <li><a href="#">Combo 1 Người</a></li>
                        <li><a href="#">Combo Nhóm</a></li>
                        <li><a href="#">Gà Rán - Gà Quay</a></li>
                        <li><a href="#">Burger - Cơm - Mì Ý</a></li>
                        <li><a href="#">Thức Ăn Nhẹ</a></li>
                        <li><a href="#">Thức Uống & Tráng Miệng</a></li>
                    </ul>
                </div>

                <!-- Về Chúng Tôi -->
                <div class="col-md-3">
                    <h5>Về Chúng Tôi</h5>
                    <ul>
                        <li><a href="#">Câu Chuyện Của Chúng Tôi</a></li>
                        <li><a href="#">Tin Khuyến Mãi</a></li>
                        <li><a href="#">Tin tức</a></li>
                        <li><a href="#">Tuyển dụng</a></li>
                        <li><a href="#">Đặt tiệc Sinh nhật</a></li>
                    </ul>
                </div>

                <!-- Liên hệ -->
                <div class="col-md-3">
                    <h5>Liên Hệ</h5>
                    <ul>
                        <li><a href="#">Theo dõi đơn hàng</a></li>
                        <li><a href="#">Hệ Thống Nhà Hàng</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>

                <!-- Chính sách -->
                <div class="col-md-3">
                    <h5>Chính Sách</h5>
                    <ul>
                        <li><a href="#">Chính sách hoạt động</a></li>
                        <li><a href="#">Chính sách và quy định</a></li>
                        <li><a href="#">Chính sách bảo mật thông tin</a></li>
                    </ul>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-6">
                    <a asp-controller="SanPhams" asp-action="StoreLocation">
                        <img src="~/images/map.jpg" alt="Xem vị trí cửa hàng" style="width: 100px; height: 100px;" />
                    </a>


                </div>
                <div class="col-md-6 text-right">
                    
                    <a href="#"><i class="fab fa-facebook-f"></i><img src="~/images/fb.png" alt="facebook" class="store-logo"></a>
                    <a href="#"><i class="fab fa-instagram"></i><img src="~/images/ig.jpg" alt="instagram" class="store-logo"></a>
                    <a href="#"><i class="fab fa-youtube"></i><img style="height:40px;" src="~/images/Youtube.png" alt="youtube" class="store-logo"></a>
                    <a href="#"><i class="fab fa-twitter"></i><img src="~/images/tw.png" alt="twitter" class="store-logo"></a>
                </div>
            </div>

     
        </div>
    </footer>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function updateCartCount() {
            $.get("/GioHang/GetCartItemCount", function (data) {
                $("#cart-count").text(data);
            });
        }

        $(document).ready(function () {
            updateCartCount();
        });
    </script>

</body>
</html>
