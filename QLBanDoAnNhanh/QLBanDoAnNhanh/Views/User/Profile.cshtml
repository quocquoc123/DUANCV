@model QLBanDoAnNhanh.Models.NguoiDung

<style>
/* Container chính */
.user-info-container {
    max-width: 600px; /* Giới hạn chiều rộng */
    margin: 20px auto; /* Căn giữa theo chiều ngang */
    padding: 20px; /* Khoảng cách bên trong */
    background-color: #ffffff; /* Màu nền trắng */
    border-radius: 8px; /* Bo góc */
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Đổ bóng nhẹ */
}

/* Tiêu đề */
.user-info-container h2 {
    font-size: 24px; /* Kích thước chữ */
    font-weight: bold; /* Chữ đậm */
    margin-bottom: 20px; /* Khoảng cách phía dưới */
    color: #333; /* Màu chữ */
}

/* Form thông tin */
.user-info-form {
    display: flex; /* Sử dụng Flexbox */
    flex-direction: column; /* Xếp dọc */
}

/* Nhóm form */
.user-info-form .form-group {
    margin-bottom: 15px; /* Khoảng cách giữa các nhóm */
}

/* Nhãn */
.user-info-form .form-label {
    font-weight: bold; /* Chữ đậm */
    margin-bottom: 5px; /* Khoảng cách với input */
    display: block; /* Hiển thị nhãn trên dòng riêng */
    color: #555; /* Màu chữ nhãn */
}

/* Ô nhập liệu */
.user-info-form .form-control {
    border: 1px solid #ced4da; /* Viền ô nhập */
    border-radius: 4px; /* Bo góc */
    padding: 10px; /* Khoảng cách trong ô */
    font-size: 14px; /* Kích thước chữ */
    color: #333; /* Màu chữ */
    transition: border-color 0.3s, box-shadow 0.3s; /* Hiệu ứng chuyển đổi */
}

.user-info-form .form-control:focus {
    border-color: #007bff; /* Màu viền khi chọn */
    box-shadow: 0 0 5px rgba(0, 123, 255, 0.25); /* Hiệu ứng sáng */
}

/* Nút cập nhật */
.user-info-form .btn-primary {
    background-color: #f2b633; /* Màu nền */
    border: none; /* Xóa viền */
    color: white; /* Màu chữ */
    padding: 10px 15px; /* Khoảng cách trong nút */
    border-radius: 50px; /* Bo tròn hoàn toàn */
    font-size: 16px; /* Kích thước chữ */
    font-weight: bold; /* Chữ đậm */
    transition: background-color 0.3s; /* Hiệu ứng màu nền */
}

.user-info-form .btn-primary:hover {
    background-color: #c28500; /* Màu nền khi hover */
}

/* Cảnh báo */
.user-info-form .alert {
    margin-top: 20px; /* Khoảng cách phía trên */
    padding: 10px 15px; /* Khoảng cách bên trong */
    font-size: 14px; /* Kích thước chữ */
    border-radius: 4px; /* Bo góc */
}

.user-info-form .alert-success {
    background-color: #d4edda; /* Nền xanh nhạt */
    color: #155724; /* Chữ xanh đậm */
    border: 1px solid #c3e6cb; /* Viền */
}

.user-info-form .alert-danger {
    background-color: #f8d7da; /* Nền đỏ nhạt */
    color: #721c24; /* Chữ đỏ đậm */
    border: 1px solid #f5c6cb; /* Viền */
}

/* Responsive */


</style>

<div class="user-info-container">
    <h2 class="text-center">Quản lý thông tin cá nhân</h2>

    @using (Html.BeginForm("Profile", "User", FormMethod.Post, new { @class = "user-info-form" }))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            @Html.LabelFor(m => m.HoTen, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nhập họ tên" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Nhập email" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Sdt, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Sdt, new { @class = "form-control", placeholder = "Nhập số điện thoại" })
        </div>

        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">Cập nhật</button>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success mt-3 text-center">@ViewBag.Message</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-3 text-center">@ViewBag.Error</div>
        }
    }
</div>


