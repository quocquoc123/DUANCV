@model QLBanDoAnNhanh.Models.NguoiDung

@{
    ViewData["Title"] = "Thong Tin Ca Nhan";
    var avatarUrl = ViewBag.AvatarUrl as string ?? "/images/acount.png";
}

<style>
.profile-page {
    max-width: 1120px;
    margin: 36px auto 60px;
    padding: 0 20px;
}

.profile-shell {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 26px;
    align-items: start;
}

.profile-side,
.profile-main {
    background: #fff;
    border-radius: 28px;
    box-shadow: 0 18px 45px rgba(37, 24, 14, 0.08);
    border: 1px solid rgba(0, 0, 0, 0.04);
}

.profile-side {
    padding: 28px 24px;
    text-align: center;
    position: sticky;
    top: 120px;
}

.profile-avatar-wrap {
    width: 152px;
    height: 152px;
    margin: 0 auto 18px;
    border-radius: 50%;
    padding: 6px;
    background: linear-gradient(135deg, #ffb347, #ff8c00);
    box-shadow: 0 18px 36px rgba(214, 123, 0, 0.22);
}

.profile-avatar {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 50%;
    background: #fff8ef;
}

.profile-side h1 {
    font-size: 24px;
    color: #2b1a10;
    margin-bottom: 6px;
}

.profile-side p {
    color: #7b6b5d;
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 18px;
}

.profile-meta {
    display: grid;
    gap: 10px;
    text-align: left;
}

.profile-meta-item {
    padding: 12px 14px;
    border-radius: 16px;
    background: linear-gradient(135deg, #fffaf3, #fff4e3);
    border: 1px solid rgba(255, 152, 0, 0.1);
}

.profile-meta-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #b07b44;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    margin-bottom: 2px;
}

.profile-meta-value {
    color: #3a2415;
    font-weight: 700;
    word-break: break-word;
}

.profile-main {
    padding: 32px;
}

.profile-heading {
    margin-bottom: 24px;
}

.profile-heading h2 {
    font-size: 30px;
    color: #2b1a10;
    margin-bottom: 8px;
}

.profile-heading p {
    color: #7f7064;
    font-size: 14px;
}

.profile-form {
    display: grid;
    gap: 20px;
}

.profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.profile-field {
    display: grid;
    gap: 8px;
}

.profile-field--full {
    grid-column: 1 / -1;
}

.profile-label {
    font-size: 13px;
    font-weight: 800;
    color: #5c4635;
    letter-spacing: 0.2px;
}

.profile-input,
.profile-file {
    width: 100%;
    border: 1px solid #eadfce;
    border-radius: 16px;
    padding: 13px 15px;
    font-size: 14px;
    background: #fffdf9;
    color: #2b1a10;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
}

.profile-input:focus,
.profile-file:focus {
    outline: none;
    border-color: #ff9800;
    box-shadow: 0 0 0 4px rgba(255, 152, 0, 0.12);
}

.profile-file-note {
    font-size: 12.5px;
    color: #8b7b6e;
}

.profile-actions {
    display: flex;
    justify-content: flex-end;
}

.profile-submit {
    border: none;
    border-radius: 999px;
    padding: 14px 28px;
    background: linear-gradient(135deg, #ff9800, #d67b00);
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 12px 28px rgba(214, 123, 0, 0.22);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.profile-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 34px rgba(214, 123, 0, 0.28);
}

.profile-alert {
    border-radius: 16px;
    padding: 14px 16px;
    font-size: 14px;
    font-weight: 600;
}

.profile-alert--success {
    background: #ecfdf3;
    color: #166534;
    border: 1px solid #bbf7d0;
}

.profile-alert--error {
    background: #fff1f2;
    color: #be123c;
    border: 1px solid #fecdd3;
}

&#64;media (max-width: 992px) {
    .profile-shell {
        grid-template-columns: 1fr;
    }

    .profile-side {
        position: static;
    }
}

&#64;media (max-width: 640px) {
    .profile-page {
        margin-top: 24px;
        padding: 0 14px;
    }

    .profile-main,
    .profile-side {
        border-radius: 22px;
        padding: 22px 18px;
    }

    .profile-grid {
        grid-template-columns: 1fr;
    }

    .profile-heading h2 {
        font-size: 24px;
    }

    .profile-actions {
        justify-content: stretch;
    }

    .profile-submit {
        width: 100%;
    }
}
</style>

<div class="profile-page">
    <div class="profile-shell">
        <aside class="profile-side">
            <div class="profile-avatar-wrap">
                <img src="@avatarUrl" alt="Avatar @Model.HoTen" class="profile-avatar" />
            </div>
            <h1>@Model.HoTen</h1>
            <p>Cap nhat thong tin ca nhan va anh dai dien de tai khoan dong bo, de nhan dien hon tren he thong.</p>

            <div class="profile-meta">
                <div class="profile-meta-item">
                    <span class="profile-meta-label">Ten dang nhap</span>
                    <span class="profile-meta-value">@Model.Username</span>
                </div>
                <div class="profile-meta-item">
                    <span class="profile-meta-label">Email hien tai</span>
                    <span class="profile-meta-value">@Model.Email</span>
                </div>
                <div class="profile-meta-item">
                    <span class="profile-meta-label">So dien thoai</span>
                    <span class="profile-meta-value">@Model.Sdt</span>
                </div>
            </div>
        </aside>

        <section class="profile-main">
            <div class="profile-heading">
                <h2>Quản Lý Thông Tin Cá Nhân</h2>
                <p>Chinh sua thong tin co ban va tai anh dai dien phu hop voi giao dien hien tai cua Food Fast.</p>
            </div>

            @if (ViewBag.Message != null)
            {
                <div class="profile-alert profile-alert--success">@ViewBag.Message</div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="profile-alert profile-alert--error">@ViewBag.Error</div>
            }

            @using (Html.BeginForm("Profile", "User", FormMethod.Post, new { @class = "profile-form", enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="profile-grid">
                    <div class="profile-field">
                        <label class="profile-label" for="HoTen">Ho ten</label>
                        @Html.TextBoxFor(m => m.HoTen, new { @class = "profile-input", placeholder = "Nhap ho ten" })
                    </div>

                    <div class="profile-field">
                        <label class="profile-label" for="Email">Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "profile-input", placeholder = "Nhap email", type = "email" })
                    </div>

                    <div class="profile-field">
                        <label class="profile-label" for="Sdt">So dien thoai</label>
                        @Html.TextBoxFor(m => m.Sdt, new { @class = "profile-input", placeholder = "Nhap so dien thoai" })
                    </div>

                    <div class="profile-field">
                        <label class="profile-label" for="usernameReadonly">Ten dang nhap</label>
                        <input id="usernameReadonly" class="profile-input" value="@Model.Username" readonly />
                    </div>

                    <div class="profile-field profile-field--full">
                        <label class="profile-label" for="avatarFile">Anh dai dien</label>
                        <input id="avatarFile" name="avatarFile" type="file" class="profile-file" accept="image/*" />
                        <div class="profile-file-note">Chap nhan anh moi de cap nhat avatar. Anh moi se thay the anh cu.</div>
                    </div>
                </div>

                <div class="profile-actions">
                    <button type="submit" class="profile-submit">Luu Thay Doi</button>
                </div>
            }
        </section>
    </div>
</div>
