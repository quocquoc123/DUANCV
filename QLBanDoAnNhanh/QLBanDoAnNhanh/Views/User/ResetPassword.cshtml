@model QLBanDoAnNhanh.Models.NguoiDung
@{
    ViewData["Title"] = "ResetPassword";
    Layout = null;
}
<style>
    /* Định dạng tổng thể */
    body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f9;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
    }

    /* Định dạng cho tiêu đề */
    h2 {
        text-align: center;
        color: #333;
        margin-bottom: 20px;
    }

    /* Định dạng cho form container */
    .row {
        width: 100%;
        max-width: 500px;
    }

    /* Định dạng cho thẻ card */
    .card {
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .card-header {
        background-color: #007bff;
        color: #fff;
        padding: 10px 15px;
    }

    .card-title {
        font-weight: bold;
    }

    /* Định dạng cho nội dung card */
    .card-body {
        padding: 20px;
    }

    /* Định dạng cho nhãn */
    label {
        font-weight: bold;
        color: #555;
    }

    /* Định dạng cho input */
    .form-control {
        border-radius: 4px;
        border: 1px solid #ddd;
        padding: 10px;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.2);
        }

    /* Định dạng cho nhóm input có biểu tượng */
    .input-group {
        display: flex;
        align-items: center;
    }

    .input-group-append {
        margin-left: -1px;
    }

    .btn-outline-secondary {
        background-color: #f4f4f9;
        border: 1px solid #ddd;
        border-left: none;
        padding: 10px;
        cursor: pointer;
    }

        .btn-outline-secondary:hover {
            background-color: #e2e2e8;
        }

    /* Định dạng cho nút submit */
    .btn-success {
        width: 100%;
        padding: 10px;
        background-color: #28a745;
        border: none;
        border-radius: 4px;
        color: white;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    /* Định dạng cho liên kết quay lại đăng nhập */
    .btn-link {
        color: #007bff;
        text-decoration: none;
    }

        .btn-link:hover {
            text-decoration: underline;
        }

    /* Định dạng cho thông báo lỗi và thành công */
    .badge-danger {
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        display: block;
        margin-bottom: 10px;
    }

    .badge-success {
        background-color: #28a745;
        color: white;
        padding: 5px 10px;
        display: block;
        margin-bottom: 10px;
    }

    /* Định dạng cho thông báo lỗi xác thực */
    .text-danger {
        font-size: 14px;
        color: red;
        margin-top: 5px;
    }

</style>


<div class="row justify-content-md-center">
    <div class="col-md-5">
        @using (Html.BeginForm("ResetPassword", "User", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="card">
                <div class="card-header">
                    <div class="card-title">Đặt lại mật khẩu</div>
                </div>

                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <span class="badge text-left badge-danger">@ViewBag.Error</span>
                    }

                    @if (ViewBag.Message != null)
                    {
                        <span class="badge text-left badge-success">@ViewBag.Message</span>
                    }

                    <div class="form-group">
                        @Html.Label("Mật khẩu mới")
                        <div class="input-group">
                            @Html.Editor("newPassword", new { htmlAttributes = new { @class = "form-control", @id = "newPassword", @type = "password", required = "required" } })
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('newPassword')">
                                    <i id="eyeNew" class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        @Html.ValidationMessage("newPassword", "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.Label("Xác nhận mật khẩu")
                        <div class="input-group">
                            @Html.Editor("confirmPassword", new { htmlAttributes = new { @class = "form-control", @id = "confirmPassword", @type = "password", required = "required" } })
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('confirmPassword')">
                                    <i id="eyeConfirm" class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        @Html.ValidationMessage("confirmPassword", "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-success">Đặt lại mật khẩu</button>
                    </div>

                    <p>
                        @Html.ActionLink("Quay lại đăng nhập", "Login", "User", null, new { @class = "btn btn-link" })
                    </p>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const eyeIcon = inputId === 'newPassword' ? document.getElementById('eyeNew') : document.getElementById('eyeConfirm');
            const type = input.getAttribute('type') === 'password' ? 'text' : 'password';

            input.setAttribute('type', type);
            eyeIcon.classList.toggle('fa-eye'); // Thay đổi biểu tượng từ con mắt đóng sang mở
            eyeIcon.classList.toggle('fa-eye-slash'); // Thay đổi biểu tượng từ con mắt mở sang đóng
        }
    </script>
}