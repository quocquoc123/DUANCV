@model QLBanDoAnNhanh.Models.NguoiDung
@{
    ViewData["Title"] = "VerifyRecoveryCode";
    Layout = null;
}
<style>
    /* Định dạng tổng thể */
    body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f9;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
    }

    /* Định dạng cho container chính */
    .row {
        width: 100%;
        max-width: 500px;
    }

    /* Định dạng cho thẻ card */
    .card {
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .card-header {
        background-color: #007bff;
        color: #fff;
        padding: 10px 15px;
    }

    .card-title {
        font-weight: bold;
    }

    /* Định dạng cho nội dung card */
    .card-body {
        padding: 20px;
    }

    /* Định dạng cho nhãn */
    label {
        font-weight: bold;
        color: #555;
    }

    /* Định dạng cho input */
    .form-control {
        border-radius: 4px;
        border: 1px solid #ddd;
        padding: 10px;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.2);
        }

    /* Định dạng cho nút xác nhận */
    .btn-success {
        width: 100%;
        padding: 10px;
        background-color: #28a745;
        border: none;
        border-radius: 4px;
        color: white;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    /* Định dạng cho liên kết quay lại đăng nhập */
    .btn-link {
        color: #007bff;
        text-decoration: none;
    }

        .btn-link:hover {
            text-decoration: underline;
        }

    /* Định dạng cho thông báo lỗi */
    .badge-danger {
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        display: block;
        margin-bottom: 10px;
    }

    /* Định dạng cho thông báo lỗi xác thực */
    .text-danger {
        font-size: 14px;
        color: red;
        margin-top: 5px;
    }

</style>

<div class="row justify-content-md-center">
    <div class="col-md-5">
        @using (Html.BeginForm("VerifyRecoveryCode", "User", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="card">
                <div class="card-header">
                    @Html.Label("Mã khôi phục")
                </div>

                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <span class="badge text-left badge-danger">@ViewBag.Error</span>
                    }

                    <div class="form-group">
                       
                        @Html.TextBox("recoveryCode", null, new { @class = "form-control", @placeholder = "Nhập mã khôi phục", required = "required" })
                        @Html.ValidationMessage("recoveryCode", "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-success">Xác nhận</button>
                    </div>

                    <p>
                        @Html.ActionLink("Quay lại đăng nhập", "Login", "User", null, new { @class = "btn btn-link" })
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}