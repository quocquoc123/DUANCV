@model QLBanDoAnNhanh.Models.KhuyenMai

@{
    ViewData["Title"] = "Xóa Khuyến Mãi";
    Layout = "~/Views/Shared/_LayouAdmin.cshtml";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1><i class="fas fa-trash-alt"></i> Xóa Khuyến Mãi</h1>
            <hr />

            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa khuyến mãi này không? Hành động này không thể hoàn tác.
            </div>

            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">@Model.MaKhuyenMai</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Mã Khuyến Mãi:</strong>
                            <p>@Html.DisplayFor(model => model.MaKhuyenMai)</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Giá Trị Giảm:</strong>
                            <p>
                                <span class="badge bg-info">
                                    @Html.DisplayFor(model => model.GiaTri)%
                                </span>
                            </p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Thời Gian Bắt Đầu:</strong>
                            <p>@Html.DisplayFor(model => model.ThoiGianBatDau)</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Thời Gian Kết Thúc:</strong>
                            <p>@Html.DisplayFor(model => model.ThoiGianKetThuc)</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Số Lượng:</strong>
                            <p>@Html.DisplayFor(model => model.SoLuong)</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Điều Kiện Áp Dụng:</strong>
                            <p>
                                @if (Model.DieuKienApDung.HasValue)
                                {
                                    <span>@string.Format("{0:N0}", Model.DieuKienApDung) VND</span>
                                }
                                else
                                {
                                    <span class="text-muted">Không có điều kiện</span>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Trạng Thái:</strong>
                            <p>
                                @if (Model.TrangThai)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle"></i> Kích Hoạt
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-times-circle"></i> Tắt
                                    </span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6">
                            <strong>Ngày Tạo:</strong>
                            <p>@Html.DisplayFor(model => model.NgayTao)</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <form asp-action="Delete" method="post" style="display: inline;">
                    <input type="hidden" asp-for="MaKhuyenMai" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Xóa Khuyến Mãi
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay Lại
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: none;
        border-radius: 8px;
    }

    .card-header {
        border-radius: 8px 8px 0 0;
    }

    .card-body {
        padding: 30px;
    }

    strong {
        color: #333;
        font-weight: 600;
    }

    p {
        margin-bottom: 0;
        color: #666;
        padding: 8px 0;
    }

    .alert {
        border-left: 4px solid #dc3545;
    }

    .btn {
        margin-right: 10px;
    }

    h1 {
        color: #333;
        font-weight: 700;
    }
</style>
