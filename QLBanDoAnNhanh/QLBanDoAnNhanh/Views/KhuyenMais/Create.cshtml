@model QLBanDoAnNhanh.Models.KhuyenMai

@{
    ViewData["Title"] = "Tạo Khuyến Mãi";
    Layout = "~/Views/Shared/_LayouAdmin.cshtml";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h1>Tạo Mã Khuyến Mãi</h1>
            <hr />

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="form-group mb-3">
                    <label asp-for="MaKhuyenMai" class="form-label">Mã Khuyến Mãi</label>
                    <input asp-for="MaKhuyenMai" class="form-control" placeholder="VD: KHUYENMAI001" required />
                    <span asp-validation-for="MaKhuyenMai" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="GiaTri" class="form-label">Giá Trị Giảm (%)</label>
                    <input asp-for="GiaTri" type="number" min="0" max="100" class="form-control" placeholder="VD: 10" required />
                    <span asp-validation-for="GiaTri" class="text-danger"></span>
                    <small class="form-text text-muted">Nhập phần trăm giảm giá từ 0-100</small>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SoLuong" class="form-label">Số Lượng Mã</label>
                    <input asp-for="SoLuong" type="number" min="1" class="form-control" placeholder="VD: 100" required />
                    <span asp-validation-for="SoLuong" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DieuKienApDung" class="form-label">Điều Kiện Áp Dụng (Số tiền tối thiểu - VND)</label>
                    <input asp-for="DieuKienApDung" type="number" min="0" class="form-control" placeholder="VD: 100000" />
                    <span asp-validation-for="DieuKienApDung" class="text-danger"></span>
                    <small class="form-text text-muted">Để trống nếu không có điều kiện</small>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="ThoiGianBatDau" class="form-label">Thời Gian Bắt Đầu</label>
                            <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="ThoiGianBatDau" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="ThoiGianKetThuc" class="form-label">Thời Gian Kết Thúc</label>
                            <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="ThoiGianKetThuc" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="TrangThai" />
                        <label class="form-check-label" asp-for="TrangThai">
                            Kích hoạt khuyến mãi
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-success me-2">
                        <i class="fas fa-save"></i> Tạo Khuyến Mãi
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay Lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .form-control:focus {
        border-color: #ff9800;
        box-shadow: 0 0 0 0.2rem rgba(255, 152, 0, 0.25);
    }

    .btn-success {
        background-color: #28a745;
        border: none;
    }

    .btn-success:hover {
        background-color: #218838;
    }

    .alert-danger {
        border-left: 4px solid #dc3545;
    }
</style>

