@{
    ViewData["Title"] = "Trò Chuyện Hỗ Trợ";
}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="container text-center" style="font-family: 'Plus Jakarta Sans', sans-serif; padding: 100px 20px; max-width: 600px; margin: 0 auto;">
    <div style="font-size: 5rem; margin-bottom: 24px; background: linear-gradient(135deg, #0084ff 0%, #00c6ff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 12px rgba(0, 132, 255, 0.15));">
        <i class="bi bi-messenger"></i>
    </div>
    <h2 style="font-weight: 800; color: #0f172a; margin-bottom: 12px; letter-spacing: -0.5px;">Giao Diện Chat Đã Được Kích Hoạt!</h2>
    <p style="font-size: 1rem; color: #64748b; line-height: 1.6; margin-bottom: 30px;">
        Hệ thống chat hỗ trợ khách hàng trực tuyến đã được tích hợp ở góc phải màn hình của bạn. Hãy nhấn vào bong bóng chat để bắt đầu trò chuyện với Food Fast Support từ bất kỳ trang nào.
    </p>
    <button onclick="toggleGlobalChat()" style="background: linear-gradient(135deg, #0084ff 0%, #00a2ff 100%); color: white; border: none; padding: 12px 30px; font-weight: 700; border-radius: 30px; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 15px rgba(0, 132, 255, 0.3); transition: all 0.25s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
        Mở Khung Chat Ngay
    </button>
</div>
