@{
    var userLogin = ViewBag.UserLogin; // Username từ session
    var isAdmin = ViewBag.IsAdmin; // Kiểm tra nếu là admin
}
<style>
    /* Bong bóng chat */
    #chatBubble {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        cursor: pointer;
        z-index: 1000;
    }

        #chatBubble img {
            width: 30px;
            height: 30px;
        }

    /* Khung chat ẩn mặc định */
    #chatContainer {
        position: fixed;
        bottom: 80px;
        right: 20px;
        width: 300px;
        height: 400px;
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        display: none;
        flex-direction: column;
        overflow: hidden;
        z-index: 999;
    }

        /* Hiển thị khung chat khi nhấn */
        #chatContainer.active {
            display: flex;
        }

    /* Khung chat */
    #chatBox {
        flex-grow: 1;
        padding: 10px;
        background-color: #f5f6fa;
        overflow-y: auto;
    }

    /* Vùng nhập và nút gửi */
    #inputContainer {
        display: flex;
        padding: 10px;
        background-color: #f0f2f5;
        border-top: 1px solid #ddd;
    }

    #username {
        display: none;
    }

    #message {
        flex: 1;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        margin-right: 8px;
    }

    #sendButton {
        background-color: #0078fe;
        color: white;
        padding: 8px 15px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-weight: bold;
        transition: background-color 0.3s;
    }

        #sendButton:hover {
            background-color: #005bb5;
        }

</style>
<div id="chatBubble" onclick="toggleChat()">
    <img src="~/images/chattt.jpg" alt="Chat Icon" />
</div>

<div id="chatContainer">
    <div id="chatBox"></div>
    <div id="inputContainer">
        <input type="text" id="username" value="@userLogin" placeholder="Enter your username" readonly />
        <input type="text" id="message" placeholder="Enter your message" />
        <button id="sendButton">Gửi</button>
    </div>
</div>

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script>
    var connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

    connection.on("ReceiveMessage", function (user, message) {
        var encodedUser = $("<div />").text(user).html();
        var encodedMsg = $("<div />").text(message).html();
        $("#chatBox").append("<p class='bubble user'><strong>" + encodedUser + "</strong>: " + encodedMsg + "</p>");
    });

    $("#sendButton").click(function () {
        var userLogin = $("#username").val();
        var message = $("#message").val();

        if (message) {
            connection.invoke("SendMessage", userLogin, message).catch(function (err) {
                return console.error(err.toString());
            });
            $("#message").val("").focus();
        }
    });

    connection.start().catch(function (err) {
        console.error(err.toString());
    });

    function toggleChat() {
        const chatContainer = document.getElementById("chatContainer");
        chatContainer.classList.toggle("active");
    }
</script>
