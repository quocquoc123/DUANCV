@model QLBanDoAnNhanh.Models.ChiNhanh

@{
    ViewData["Title"] = "Thêm Chi Nhánh Mới";
    Layout = "~/Views/Shared/_LayouAdmin.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container-fluid mt-4" style="max-width:780px;">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a asp-action="AdminIndex" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <h1 class="mb-0"><i class="fas fa-plus-circle text-success"></i> Thêm Chi Nhánh Mới</h1>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                @* Tên chi nhánh *@
                <div class="mb-3">
                    <label asp-for="TenChiNhanh" class="form-label fw-semibold"></label>
                    <input asp-for="TenChiNhanh" class="form-control" placeholder="VD: Chi nhánh Quận 1" />
                    <span asp-validation-for="TenChiNhanh" class="text-danger small"></span>
                </div>

                @* Địa chỉ + tọa độ – chọn từ dropdown cascade & Bản đồ *@
                <div class="card border-primary mb-3">
                    <div class="card-header bg-primary bg-opacity-10 text-primary fw-semibold">
                        <i class="fas fa-map-marker-alt"></i> Địa chỉ chi nhánh & Tọa độ bản đồ
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <select id="selProvince" class="form-select form-select-sm">
                                    <option value="">-- Đang tải... --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Quận / Huyện <span class="text-danger">*</span></label>
                                <select id="selDistrict" class="form-select form-select-sm" disabled>
                                    <option value="">-- Chọn tỉnh trước --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold small">Phường / Xã</label>
                                <select id="selWard" class="form-select form-select-sm" disabled>
                                    <option value="">-- Chọn quận trước --</option>
                                </select>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-semibold small">Số nhà / Đường <span class="text-muted fw-normal">(tuỳ chọn)</span></label>
                                <input type="text" id="addrStreet" class="form-control form-control-sm"
                                       placeholder="VD: 123 Lê Lợi" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-semibold small">Địa chỉ đầy đủ</label>
                                <input asp-for="DiaChi" id="diaChiInput" class="form-control form-control-sm bg-light"
                                       readonly placeholder="Tự động điền sau khi chọn vị trí" />
                                <span asp-validation-for="DiaChi" class="text-danger small"></span>
                            </div>
                        </div>

                        <div id="geocodeStatus" class="small mb-2"></div>
                        <div id="geocodeResult" class="d-none mb-3">
                            <div class="alert alert-success py-2 mb-0 d-flex align-items-center gap-2 small">
                                <i class="fas fa-check-circle"></i>
                                <span id="geocodeResultText"></span>
                            </div>
                        </div>
                        <div id="geocodeError" class="d-none mb-3">
                            <div class="alert alert-warning py-2 mb-0 small">
                                <i class="fas fa-exclamation-triangle"></i>
                                <span id="geocodeErrorText"></span>
                            </div>
                        </div>

                        @* Bản đồ xem trước và chỉnh sửa vị trí *@
                        <div class="mb-3">
                            <label class="form-label fw-semibold small"><i class="fas fa-map"></i> Bản đồ xác định vị trí chi nhánh</label>
                            <div id="mapPreview" style="height: 280px; width: 100%; border-radius: 8px; z-index: 1;" class="border"></div>
                            <div class="form-text small mt-1 text-muted">
                                <i class="fas fa-info-circle text-primary"></i> Mẹo: Bạn có thể <strong>kéo thả ghim đỏ</strong> hoặc <strong>click trực tiếp lên bản đồ</strong> để chỉnh vị trí kinh/vĩ độ chuẩn xác 100%.
                            </div>
                        </div>

                        @* Vĩ độ & Kinh độ trực quan *@
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label asp-for="Latitude" class="form-label fw-semibold small">Vĩ độ (Latitude)</label>
                                <input asp-for="Latitude" id="inputLatitude" class="form-control form-control-sm" placeholder="VD: 10.776889" step="any" type="number" />
                                <span asp-validation-for="Latitude" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Longitude" class="form-label fw-semibold small">Kinh độ (Longitude)</label>
                                <input asp-for="Longitude" id="inputLongitude" class="form-control form-control-sm" placeholder="VD: 106.700806" step="any" type="number" />
                                <span asp-validation-for="Longitude" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                @* SĐT + Email *@
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                        <input asp-for="SoDienThoai" class="form-control" placeholder="VD: 028 1234 5678" />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="VD: q1@foodfast.vn" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                @* Giờ mở / đóng cửa *@
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="GioMoCua" class="form-label fw-semibold"></label>
                        <input asp-for="GioMoCua" type="time" class="form-control" value="07:00" />
                        <span asp-validation-for="GioMoCua" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="GioDongCua" class="form-label fw-semibold"></label>
                        <input asp-for="GioDongCua" type="time" class="form-control" value="22:00" />
                        <span asp-validation-for="GioDongCua" class="text-danger small"></span>
                    </div>
                </div>

                @* Hình ảnh *@
                <div class="mb-3">
                    <label class="form-label fw-semibold">Hình ảnh chi nhánh</label>
                    <input type="file" name="hinhAnhFile" class="form-control" accept="image/*"
                           id="imgPicker" onchange="previewImg(this)" />
                    <div class="form-text">Định dạng JPG, PNG, WEBP. Tải lên Cloudinary tự động.</div>
                    <img id="imgPreview" src="#" alt="Preview" class="mt-2 rounded"
                         style="max-height:180px;display:none;" />
                </div>

                @* Trạng thái *@
                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="TrangThai" class="form-check-input" type="checkbox"
                               id="trangThaiSwitch" checked="@Model?.TrangThai" />
                        <label class="form-check-label fw-semibold" for="trangThaiSwitch">
                            Đang hoạt động
                        </label>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save"></i> Lưu chi nhánh
                    </button>
                    <a asp-action="AdminIndex" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        function previewImg(input) {
            const preview = document.getElementById('imgPreview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => { preview.src = e.target.result; preview.style.display = 'block'; };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // ===== LEAFLET MAP INITIALIZATION =====
        let map, marker;
        const DEFAULT_LAT = 10.776889;
        const DEFAULT_LNG = 106.700806;

        function initMap(lat, lng) {
            const initialLat = lat || DEFAULT_LAT;
            const initialLng = lng || DEFAULT_LNG;

            if (!map) {
                map = L.map('mapPreview').setView([initialLat, initialLng], 15);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);

                marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

                // Kéo ghim marker -> cập nhật ô Lat/Lng
                marker.on('dragend', function (e) {
                    const pos = e.target.getLatLng();
                    setCoordinates(pos.lat, pos.lng, "✓ Đã cập nhật tọa độ theo vị trí kéo ghim trên bản đồ");
                });

                // Click trên bản đồ -> di chuyển marker & cập nhật ô Lat/Lng
                map.on('click', function (e) {
                    marker.setLatLng(e.latlng);
                    setCoordinates(e.latlng.lat, e.latlng.lng, "✓ Đã chọn vị trí từ điểm click trên bản đồ");
                });
            } else {
                map.setView([initialLat, initialLng], 15);
                marker.setLatLng([initialLat, initialLng]);
            }
        }

        function setCoordinates(lat, lng, statusMsg) {
            const latVal = parseFloat(lat).toFixed(6);
            const lngVal = parseFloat(lng).toFixed(6);
            document.getElementById('inputLatitude').value = latVal;
            document.getElementById('inputLongitude').value = lngVal;

            if (map && marker) {
                const currentPos = marker.getLatLng();
                if (Math.abs(currentPos.lat - lat) > 0.00001 || Math.abs(currentPos.lng - lng) > 0.00001) {
                    map.setView([lat, lng], 15);
                    marker.setLatLng([lat, lng]);
                }
            }
            if (statusMsg) {
                showGeocodeSuccess(statusMsg);
            }
        }

        // Lắng nghe sự thay đổi khi người dùng tự gõ vào ô Latitude/Longitude
        document.getElementById('inputLatitude').addEventListener('change', function () {
            const lat = parseFloat(this.value);
            const lng = parseFloat(document.getElementById('inputLongitude').value);
            if (!isNaN(lat) && !isNaN(lng)) initMap(lat, lng);
        });
        document.getElementById('inputLongitude').addEventListener('change', function () {
            const lat = parseFloat(document.getElementById('inputLatitude').value);
            const lng = parseFloat(this.value);
            if (!isNaN(lat) && !isNaN(lng)) initMap(lat, lng);
        });

        // Tải bản đồ ban đầu
        document.addEventListener("DOMContentLoaded", function () {
            initMap(DEFAULT_LAT, DEFAULT_LNG);
        });

        // ===== Cascade Dropdown: Tỉnh → Huyện → Xã + Multi-stage Geocode =====
        const API_BASE = 'https://provinces.open-api.vn/api';
        const selProvince = document.getElementById('selProvince');
        const selDistrict = document.getElementById('selDistrict');
        const selWard     = document.getElementById('selWard');
        const statusEl    = document.getElementById('geocodeStatus');
        let geocodeTimeout = null;

        // 1. Load danh sách tỉnh/thành
        (async () => {
            try {
                const res  = await fetch(`${API_BASE}/p/`);
                const data = await res.json();
                selProvince.innerHTML = '<option value="">-- Chọn Tỉnh / Thành phố --</option>';
                data.forEach(p => {
                    selProvince.innerHTML += `<option value="${p.code}">${p.name}</option>`;
                });
            } catch {
                selProvince.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
            }
        })();

        // 2. Khi chọn tỉnh → load quận/huyện
        selProvince.addEventListener('change', async function () {
            const code = this.value;
            selDistrict.innerHTML = '<option value="">-- Đang tải... --</option>';
            selDistrict.disabled  = true;
            selWard.innerHTML     = '<option value="">-- Chọn quận trước --</option>';
            selWard.disabled      = true;
            hideGeocodeResult();
            if (!code) return;
            try {
                const res  = await fetch(`${API_BASE}/p/${code}?depth=2`);
                const data = await res.json();
                selDistrict.innerHTML = '<option value="">-- Chọn Quận / Huyện --</option>';
                data.districts.forEach(d => {
                    selDistrict.innerHTML += `<option value="${d.code}">${d.name}</option>`;
                });
                selDistrict.disabled = false;
            } catch {
                selDistrict.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
            }
        });

        // 3. Khi chọn quận → load phường/xã
        selDistrict.addEventListener('change', async function () {
            const code = this.value;
            selWard.innerHTML = '<option value="">-- Đang tải... --</option>';
            selWard.disabled  = true;
            hideGeocodeResult();
            if (!code) return;
            try {
                const res  = await fetch(`${API_BASE}/d/${code}?depth=2`);
                const data = await res.json();
                selWard.innerHTML = '<option value="">-- Chọn Phường / Xã (tuỳ chọn) --</option>';
                data.wards.forEach(w => {
                    selWard.innerHTML += `<option value="${w.code}">${w.name}</option>`;
                });
                selWard.disabled = false;
                await autoGeocode();
            } catch {
                selWard.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
            }
        });

        // 4. Khi chọn phường/xã → geocode lại chính xác hơn
        selWard.addEventListener('change', async function () {
            await autoGeocode();
        });

        // 4b. Khi nhập số nhà / đường → Debounce tự động Geocode sau 600ms
        document.getElementById('addrStreet').addEventListener('input', function () {
            updateDiaChiOnly();
            clearTimeout(geocodeTimeout);
            geocodeTimeout = setTimeout(() => {
                autoGeocode();
            }, 600);
        });

        function updateDiaChiOnly() {
            const street   = document.getElementById('addrStreet').value.trim();
            const wardName = (selWard.value && selWard.selectedIndex > 0) ? selWard.options[selWard.selectedIndex].text : '';
            const distName = (selDistrict.value && selDistrict.selectedIndex > 0) ? selDistrict.options[selDistrict.selectedIndex].text : '';
            const provName = (selProvince.value && selProvince.selectedIndex > 0) ? selProvince.options[selProvince.selectedIndex].text : '';
            const parts = [street,
                           (selWard.value ? wardName : ''),
                           (selDistrict.value ? distName : ''),
                           (selProvince.value ? provName : '')]
                          .filter(p => p && !p.startsWith('--'));
            if (parts.length) document.getElementById('diaChiInput').value = parts.join(', ');
        }

        // 5. Hàm Geocode tự động Đa tầng (Multi-stage Fallback)
        async function autoGeocode() {
            const street   = document.getElementById('addrStreet').value.trim();
            const wardName = (selWard.value && selWard.selectedIndex > 0) ? selWard.options[selWard.selectedIndex].text : '';
            const distName = (selDistrict.value && selDistrict.selectedIndex > 0) ? selDistrict.options[selDistrict.selectedIndex].text : '';
            const provName = (selProvince.value && selProvince.selectedIndex > 0) ? selProvince.options[selProvince.selectedIndex].text : '';

            if (!distName || distName.startsWith('--')) return;

            updateDiaChiOnly();

            statusEl.innerHTML = '<span class="text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tìm tọa độ...</span>';
            hideGeocodeResult();

            // Các truy vấn ưu tiên từ chi tiết tới tổng quan để không bao giờ bị rỗng kết quả
            const candidateQueries = [];
            if (street && wardName) candidateQueries.push([street, wardName, distName, provName, 'Việt Nam'].join(', '));
            if (street) candidateQueries.push([street, distName, provName, 'Việt Nam'].join(', '));
            if (wardName) candidateQueries.push([wardName, distName, provName, 'Việt Nam'].join(', '));
            candidateQueries.push([distName, provName, 'Việt Nam'].join(', '));

            let foundData = null;

            for (const query of candidateQueries) {
                try {
                    const url  = `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`;
                    const res  = await fetch(url, { headers: { 'Accept-Language': 'vi' } });
                    const data = await res.json();
                    if (data && data.length > 0) {
                        foundData = data[0];
                        break;
                    }
                } catch (err) {
                    console.error("Lỗi geocode:", err);
                }
            }

            statusEl.innerHTML = '';
            if (foundData) {
                const lat = parseFloat(foundData.lat);
                const lon = parseFloat(foundData.lon);
                setCoordinates(lat, lon, `✓ Đã định vị thành công: Vĩ độ ${lat.toFixed(6)} | Kinh độ ${lon.toFixed(6)}`);
            } else {
                showGeocodeError('Không tự động tìm thấy tọa độ. Bạn có thể kéo thả ghim trên bản đồ để chọn.');
            }
        }

        function showGeocodeSuccess(msg) {
            document.getElementById('geocodeResultText').textContent = msg;
            document.getElementById('geocodeResult').classList.remove('d-none');
            document.getElementById('geocodeError').classList.add('d-none');
        }
        function showGeocodeError(msg) {
            document.getElementById('geocodeErrorText').textContent = msg;
            document.getElementById('geocodeError').classList.remove('d-none');
            document.getElementById('geocodeResult').classList.add('d-none');
        }
        function hideGeocodeResult() {
            document.getElementById('geocodeResult').classList.add('d-none');
            document.getElementById('geocodeError').classList.add('d-none');
        }
    </script>
}
