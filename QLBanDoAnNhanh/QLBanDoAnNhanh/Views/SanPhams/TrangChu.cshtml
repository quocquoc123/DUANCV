<script>
(function () {
    // Load wishlist states khi trang load
    async function loadWishlistStates() {
        const btns = document.querySelectorAll('.wishlist-heart-btn');
        btns.forEach(async (btn) => {
            const pid = btn.dataset.productId;
            try {
                const res = await fetch(`/Wishlist/Check/${pid}`);
                const data = await res.json();
                if (data.isWishlisted) btn.classList.add('active');
            } catch (_) { /* guest – ignore */ }
        });
    }

    // Toggle wishlist khi click
    document.querySelectorAll('.wishlist-heart-btn').forEach(btn => {
        btn.addEventListener('click', async function (e) {
            e.preventDefault();
            e.stopPropagation();
            const pid = this.dataset.productId;
            try {
                const res = await fetch(`/Wishlist/Toggle/${pid}`, { method: 'POST' });
                const data = await res.json();
                if (data.requireLogin) { window.location.href = '/User/Login'; return; }
                if (data.success) {
                    this.classList.toggle('active', data.isWishlisted);
                    this.classList.add('pop');
                    this.addEventListener('animationend', () => this.classList.remove('pop'), { once: true });
                    // Cập nhật badge wishlist trên navbar
                    const counter = document.querySelector('.wishlist-count, #wishlist-count');
                    if (counter && data.count !== undefined) {
                        counter.textContent = data.count;
                        counter.style.display = data.count > 0 ? '' : 'none';
                    }
                }
            } catch (err) { console.error('Wishlist error:', err); }
        });
    });

    loadWishlistStates();
})();
</script>

<!-- ===== Branch Filter Script (chỉ dành cho TrangChu) ===== -->
<script>
(function () {
    'use strict';

    const API_BRANCH_PRODUCTS = '/ChiNhanh/GetSanPhamTheoChiNhanh';
    const LS_KEY  = 'selectedBranchId';
    const LS_NAME = 'selectedBranchName';

    // DOM elements
    const grid         = document.getElementById('productsGrid');
    const infoBar      = document.getElementById('branchInfoBar');
    const infoName     = document.getElementById('branchInfoName');
    const clearBtn     = document.getElementById('branchInfoClearBtn');
    const sectionTitle = document.getElementById('productSectionTitle');
    const sectionSub   = document.getElementById('productSectionSubtitle');

    // Backup toàn bộ HTML sản phẩm gốc (từ server render)
    const originalGridHTML = grid ? grid.innerHTML : '';

    // ---- Hiển thị info bar ----
    function showInfoBar(name) {
        if (!infoBar || !infoName) return;
        infoName.textContent = name;
        infoBar.style.display = 'flex';
    }

    function hideInfoBar() {
        if (!infoBar) return;
        infoBar.style.display = 'none';
    }

    // ---- Render card HTML từ JSON ----
    function buildProductCard(sp) {
        const hasDiscount = sp.discountPercent > 0;
        const priceHtml = hasDiscount
            ? `<div class="product-price-block">
                <span class="product-price-sale">${Number(sp.giaSauGiamGia).toLocaleString('vi-VN')} đ</span>
                <span class="product-price-original">${Number(sp.giaTien).toLocaleString('vi-VN')} đ</span>
               </div>`
            : `<p class="product-price">${Number(sp.giaSauGiamGia).toLocaleString('vi-VN')} đ</p>`;

        const discountBadge = hasDiscount
            ? `<div class="discount-badge">-${sp.discountPercent}%</div>`
            : '';

        const catTag = sp.tenDanhMuc
            ? `<span class="product-category-tag">${escHtml(sp.tenDanhMuc)}</span>`
            : '';

        const ingredient = sp.thanhPhan
            ? `<p class="product-ingredient"><strong>Nguyên liệu:</strong> ${escHtml(sp.thanhPhan)}</p>`
            : '';

        const imgSrc = sp.hinhAnh1 || '/images/logo.jpg';
        const detailUrl = sp.detailUrl || '#';

        return `
        <div class="product-card"
             data-ma-sp="${sp.maSp}"
             data-price="${sp.giaTien}"
             data-name="${escHtml(sp.tenSp)}"
             data-sales="${sp.slbanTrongNgay}"
             data-discount="${sp.discountPercent}"
             data-category="${escHtml(sp.tenDanhMuc)}">
            <button class="wishlist-heart-btn" data-product-id="${sp.maSp}" title="Thêm vào yêu thích" aria-label="Yêu thích">
                <svg class="heart-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path class="heart-path" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
            </button>
            <div class="product-image-wrapper">
                <img src="${imgSrc}" class="product-image" alt="${escHtml(sp.tenSp)}"
                     onerror="this.src='/images/logo.jpg'" loading="lazy" />
                ${discountBadge}
                ${catTag}
                <div class="product-overlay">
                    <a href="${detailUrl}" class="btn-view-detail">Xem Chi Tiết</a>
                </div>
            </div>
            <div class="product-info">
                <h3 class="product-name">${escHtml(sp.tenSp)}</h3>
                ${priceHtml}
                ${ingredient}
                <div class="product-card-divider"></div>
                <button class="btn-buy" data-ma-sp="${sp.maSp}" data-img="${imgSrc}" aria-label="Thêm ${escHtml(sp.tenSp)} vào giỏ hàng">🛒 Thêm vào giỏ hàng</button>
            </div>
        </div>`;
    }

    // ---- Attach wishlist events cho các card mới ----
    function attachWishlistEvents() {
        document.querySelectorAll('.wishlist-heart-btn').forEach(btn => {
            btn.addEventListener('click', async function (e) {
                e.preventDefault(); e.stopPropagation();
                const pid = this.dataset.productId;
                try {
                    const res  = await fetch(`/Wishlist/Toggle/${pid}`, { method: 'POST' });
                    const data = await res.json();
                    if (data.requireLogin) { window.location.href = '/User/Login'; return; }
                    if (data.success) {
                        this.classList.toggle('active', data.isWishlisted);
                        this.classList.add('pop');
                        this.addEventListener('animationend', () => this.classList.remove('pop'), { once: true });
                    }
                } catch (_) {}
            });
        });
    }

    // ---- Filter sản phẩm theo chi nhánh ----
    async function filterByBranch(branchId, branchName) {
        if (!grid) return;

        // Loading state
        grid.innerHTML = `
        <div style="grid-column:1/-1; text-align:center; padding:48px 0; color:#bbb;">
            <div style="font-size:32px; margin-bottom:12px; animation: spin 1s linear infinite; display:inline-block;">⏳</div>
            <p style="font-size:14px;">Đang tải sản phẩm tại chi nhánh...</p>
        </div>`;

        try {
            const res  = await fetch(`${API_BRANCH_PRODUCTS}?maChiNhanh=${branchId}`);
            const data = await res.json();

            if (!data.success) {
                grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:48px 0; color:#bbb;">
                    <p style="font-size:32px;">🏪</p>
                    <p style="font-size:14px; margin-top:8px;">Không thể tải sản phẩm. Vui lòng thử lại.</p>
                </div>`;
                return;
            }

            if (data.sanPhams.length === 0) {
                grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:48px 0; color:#bbb;">
                    <p style="font-size:40px;">🍽️</p>
                    <p style="font-size:15px; font-weight:600; color:#666; margin-top:12px;">Chưa có sản phẩm tại chi nhánh này</p>
                    <p style="font-size:13px; margin-top:6px;">Chi nhánh đang cập nhật thực đơn</p>
                </div>`;
            } else {
                grid.innerHTML = data.sanPhams.map(buildProductCard).join('');
                attachWishlistEvents();
                // Load wishlist states cho các card mới
                grid.querySelectorAll('.wishlist-heart-btn').forEach(async btn => {
                    try {
                        const r = await fetch(`/Wishlist/Check/${btn.dataset.productId}`);
                        const d = await r.json();
                        if (d.isWishlisted) btn.classList.add('active');
                    } catch (_) {}
                });
            }

            // Cập nhật section header
            if (sectionTitle) sectionTitle.textContent = `Sản Phẩm Tại ${branchName}`;
            if (sectionSub)   sectionSub.textContent = `${data.total} sản phẩm có tại chi nhánh này`;

            showInfoBar(branchName);

        } catch (err) {
            console.error('Branch filter error:', err);
            grid.innerHTML = originalGridHTML; // Fallback
        }
    }

    // ---- Restore all products ----
    function restoreAllProducts() {
        if (!grid) return;
        grid.innerHTML = originalGridHTML;
        attachWishlistEvents();
        if (sectionTitle) sectionTitle.textContent = 'Danh Sách Sản Phẩm Nổi Bật';
        if (sectionSub)   sectionSub.textContent = 'Những món ăn được yêu thích nhất của chúng tôi';
        hideInfoBar();
    }

    // ---- Helper ----
    function escHtml(str) {
        if (!str) return '';
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ---- Clear btn ----
    if (clearBtn) {
        clearBtn.addEventListener('click', function () {
            localStorage.removeItem(LS_KEY);
            localStorage.removeItem(LS_NAME);
            // Thông báo cho layout picker reset
            document.dispatchEvent(new CustomEvent('branchChanged', { detail: { id: null, name: null } }));
            restoreAllProducts();
        });
    }

    // ---- Lắng nghe event từ Branch Picker (layout) ----
    document.addEventListener('branchChanged', function (e) {
        const { id, name } = e.detail;
        if (id) {
            filterByBranch(id, name);
        } else {
            restoreAllProducts();
        }
    });

    // ---- Auto-filter khi page load (nếu đã có chi nhánh trong localStorage) ----
    window.addEventListener('DOMContentLoaded', function () {
        const savedId   = localStorage.getItem(LS_KEY);
        const savedName = localStorage.getItem(LS_NAME);
        if (savedId && savedName) {
            filterByBranch(parseInt(savedId, 10), savedName);
        }
    });

})();
</script>

