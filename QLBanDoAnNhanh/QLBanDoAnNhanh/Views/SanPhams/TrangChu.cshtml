<script type="application/json" id="ff-products-data">
@Html.Raw(JsonSerializer.Serialize(productList.Select(p => new {
    tenSp = p.TenSp,
    thanhPhan = p.ThanhPhan ?? "",
    chitietSp = p.ChitietSp ?? "",
    tenDm = p.MaDmNavigation?.TenDm ?? "",
    giaTien = p.GiaTien,
    discountPercent = p.MaGiamGiaNavigation != null && p.MaGiamGiaNavigation.GiaTri > 0 && p.MaGiamGiaNavigation.ThoiGianBatDau <= DateTime.Now && p.MaGiamGiaNavigation.ThoiGianKetThuc >= DateTime.Now ? p.MaGiamGiaNavigation.GiaTri : 0,
    discountPrice = p.MaGiamGiaNavigation != null && p.MaGiamGiaNavigation.GiaTri > 0 && p.MaGiamGiaNavigation.ThoiGianBatDau <= DateTime.Now && p.MaGiamGiaNavigation.ThoiGianKetThuc >= DateTime.Now ? (decimal?)(Math.Round((decimal)p.GiaTien - ((decimal)p.GiaTien * p.MaGiamGiaNavigation.GiaTri / 100), 0)) : null,
    hinhAnh1 = Url.Content(p.HinhAnh1 ?? ""),
    detailUrl = Url.Action("ChiTietSanPham", "SanPhams", new { id = p.MaSp })
})))
</script>

<!-- Alert Messages -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Message1"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message1"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero Section -->
<div class="home-hero-band">
<div class="hero-section">
    <div class="hero-background"></div>

    <div class="hero-visual hero-visual-left">
        <img src="@Url.Content("~/images/Burger-Flava.jpg")" alt="" class="hero-food-img hero-img-1">
        <img src="@Url.Content("~/images/D-CBO-Bucket-2.jpg")" alt="" class="hero-food-img hero-img-2">
        <img src="@Url.Content("~/images/P4-OR.jpg")" alt="" class="hero-food-img hero-img-3">
    </div>

    <div class="hero-content">
        <h1 class="hero-title">Chào mừng bạn đến với</h1>
        <h2 class="hero-subtitle">Food Fast</h2>
        <p class="hero-description">Thực phẩm tươi ngon, chất lượng cao, giao hàng nhanh chóng</p>
        <a href="#products-section" class="hero-btn">Khám Phá Ngay</a>
    </div>

    <div class="hero-visual hero-visual-right">
        <img src="@Url.Content("~/images/MI-Y-GA-VIEN.jpg")" alt="" class="hero-food-img hero-img-4">
        <img src="@Url.Content("~/images/COM.jpg")" alt="" class="hero-food-img hero-img-5">
        <img src="@Url.Content("~/images/MON AN NHE.jpg")" alt="" class="hero-food-img hero-img-6">
    </div>
</div>
</div>

<!-- Promo Section -->
<div class="promo-section">
    <div class="promo-box">
        <i class="icon">⚡</i>
        <h3>Giao Hàng Nhanh</h3>
        <p>Giao trong 30 phút</p>
    </div>
    <div class="promo-box">
        <i class="icon">✓</i>
        <h3>Chất Lượng Đảm Bảo</h3>
        <p>100% sản phẩm tươi mới</p>
    </div>
    <div class="promo-box">
        <i class="icon">💳</i>
        <h3>Thanh Toán Dễ Dàng</h3>
        <p>Nhiều phương thức thanh toán</p>
    </div>
    <div class="promo-box">
        <i class="icon">👥</i>
        <h3>Hỗ Trợ 24/7</h3>
        <p>Luôn sẵn sàng phục vụ</p>
    </div>
</div>

@if (discountProducts.Count > 0)
{
    <div class="products-container discount-featured-section">
        <div class="section-header">
            <h2>Sản Phẩm Giảm Giá Nổi Bật</h2>
            <p>Ưu đãi đang áp dụng trong thời gian giới hạn</p>
        </div>

        <div class="products-grid">
            @foreach (var product in discountProducts)
            {
                var discountPercent = product.MaGiamGiaNavigation?.GiaTri ?? 0;
                var discountPrice = Math.Round((decimal)product.GiaTien - ((decimal)product.GiaTien * discountPercent / 100), 0);
                var catName = product.MaDmNavigation?.TenDm ?? "";
                <div class="product-card product-card-discount">
                    <button class="wishlist-heart-btn" data-product-id="@product.MaSp" title="Thêm vào yêu thích" aria-label="Yêu thích">
