            <div class="review-star-selector" id="reviewStarSelector" aria-label="Chọn số sao">
                <button type="button" class="review-star" data-star="1" aria-label="1 sao">★</button>
                <button type="button" class="review-star" data-star="2" aria-label="2 sao">★</button>
                <button type="button" class="review-star" data-star="3" aria-label="3 sao">★</button>
                <button type="button" class="review-star" data-star="4" aria-label="4 sao">★</button>
                <button type="button" class="review-star" data-star="5" aria-label="5 sao">★</button>
            </div>

            <div class="review-comment-wrap">
                <label for="reviewComment" class="review-comment-label">Cảm nhận của bạn (không bắt buộc)</label>
                <textarea id="reviewComment" class="review-comment-field" placeholder="Viết cảm nhận của bạn..."></textarea>
            </div>

            <form id="reviewRatingForm" asp-action="AddAndUpdateRating" asp-controller="SanPhams" method="post" hidden>
                @Html.AntiForgeryToken()
                <input type="hidden" name="maSP" value="@reviewProductId" />
                <input type="hidden" name="rating" id="reviewRatingValue" value="" />
            </form>

            <form id="reviewCommentForm" action="@Url.Action("AddComment", "SanPhams")" method="post" hidden>
                <input type="hidden" name="maSP" value="@reviewProductId" />
                <input type="hidden" name="noiDung" id="reviewCommentValue" value="" />
            </form>

            <button type="button" id="reviewSubmitButton" class="review-submit-btn" disabled>Gửi đánh giá</button>

            <div class="review-success" id="reviewSuccessState" hidden>
                <div class="review-success-check">✓</div>
                <p>Đã gửi đánh giá thành công</p>
            </div>
        </div>
    </div>
}

