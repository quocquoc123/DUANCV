@model IEnumerable<QLBanDoAnNhanh.Models.SanPham>
@using System.Text.Json

@{
    ViewData["Title"] = "Trang Chủ";
    var productList = Model?.ToList() ?? new List<QLBanDoAnNhanh.Models.SanPham>();
    var searchKeyword = ViewBag.SearchTerm as string ?? "";
    var discountProducts = ViewBag.DiscountProducts as IReadOnlyList<QLBanDoAnNhanh.Models.SanPham> ?? new List<QLBanDoAnNhanh.Models.SanPham>();
    var reviewOrderId = TempData["ReviewOrderId"]?.ToString();
    var reviewProductId = TempData["ReviewProductId"]?.ToString();
    var reviewProductName = TempData["ReviewProductName"]?.ToString();
    var reviewProductImage = TempData["ReviewProductImage"]?.ToString();
    var heroLeftImage = ViewBag.HeroLeftImage as string ?? "/images/Burger-Zinger.jpg";
    var heroLeftAlt = ViewBag.HeroLeftAlt as string ?? "Burger Zinger";
    var heroRightImage = ViewBag.HeroRightImage as string ?? "/images/Burger-Flava.jpg";
    var heroRightAlt = ViewBag.HeroRightAlt as string ?? "Burger Flava";
}

@section Styles {
    <link rel="stylesheet" href="~/css/foodfast-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/foodfast-search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/review-overlay.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/trangchu.css" asp-append-version="true" />
}

<script type="application/json" id="ff-products-data">
@Html.Raw(JsonSerializer.Serialize(productList.Select(p => new {
    tenSp = p.TenSp,
    thanhPhan = p.ThanhPhan ?? "",
    chitietSp = p.ChitietSp ?? "",
    tenDm = p.MaDmNavigation?.TenDm ?? "",
    giaTien = p.GiaTien,
    discountPercent = p.MaGiamGiaNavigation != null && p.MaGiamGiaNavigation.GiaTri > 0 && p.MaGiamGiaNavigation.ThoiGianBatDau <= DateTime.Now && p.MaGiamGiaNavigation.ThoiGianKetThuc >= DateTime.Now ? p.MaGiamGiaNavigation.GiaTri : 0,
    discountPrice = p.MaGiamGiaNavigation != null && p.MaGiamGiaNavigation.GiaTri > 0 && p.MaGiamGiaNavigation.ThoiGianBatDau <= DateTime.Now && p.MaGiamGiaNavigation.ThoiGianKetThuc >= DateTime.Now ? (decimal?)(Math.Round((decimal)p.GiaTien - ((decimal)p.GiaTien * p.MaGiamGiaNavigation.GiaTri / 100), 0)) : null,
    hinhAnh1 = Url.Content(p.HinhAnh1 ?? ""),
    detailUrl = Url.Action("ChiTietSanPham", "SanPhams", new { id = p.MaSp })
})))
</script>

<!-- Alert Messages -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Message1"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message1"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero Section -->
<div class="home-hero-band">
  <div class="hero-section">

    <!-- Ambient glow -->
    <div class="hero-background"></div>

    <!-- Decorative line-art background -->
    <partial name="_HeroDecorPartial" />

    <!-- Ảnh món ăn bên trái -->
    <div class="hero-visual hero-visual-left">
      <img src="@heroLeftImage" class="hero-food-img" alt="@heroLeftAlt" />
    </div>

    <!-- Nội dung chính -->
    <div class="hero-content">
      <h1 class="hero-title">Chào mừng bạn đến với</h1>
      <h2 class="hero-subtitle">Food Fast</h2>
      <p class="hero-description">Thực phẩm tươi ngon, giao nhanh và tiện lợi mỗi ngày.</p>

      <a href="#products-section" class="hero-btn">
        Khám Phá Ngay <span class="hero-btn-arrow">→</span>
      </a>
    </div>

    <!-- Ảnh món ăn bên phải -->
    <div class="hero-visual hero-visual-right">
      <img src="@heroRightImage" class="hero-food-img" alt="@heroRightAlt" />
    </div>

  </div>
</div>


<!-- Promo Section -->
<div class="promo-section">
    <div class="promo-box">
        <i class="icon">⚡</i>
        <h3>Giao Hàng Nhanh</h3>
        <p>Giao trong 30 phút</p>
    </div>
    <div class="promo-box">
        <i class="icon">✓</i>
        <h3>Chất Lượng Đảm Bảo</h3>
        <p>100% sản phẩm tươi mới</p>
    </div>
    <div class="promo-box">
        <i class="icon">💳</i>
        <h3>Thanh Toán Dễ Dàng</h3>
        <p>Nhiều phương thức thanh toán</p>
    </div>
    <div class="promo-box">
        <i class="icon">👥</i>
        <h3>Hỗ Trợ 24/7</h3>
        <p>Luôn sẵn sàng phục vụ</p>
    </div>
</div>

<!-- Products Section (đặt trên khối giảm giá nổi bật) -->
<div id="products-section" class="products-container" data-ff-catalog data-ff-search-term="@searchKeyword">
    <div class="section-header">
        <h2 id="productSectionTitle">@(string.IsNullOrEmpty(searchKeyword) ? "Danh Sách Sản Phẩm Nổi Bật" : "Kết Quả Tìm Kiếm")</h2>
        <p id="productSectionSubtitle">@(string.IsNullOrEmpty(searchKeyword) ? "Những món ăn được yêu thích nhất của chúng tôi" : $"Kết quả cho từ khóa \"{searchKeyword}\"")</p>
    </div>

    <!-- Branch Filter Info Bar (ẩn mặc định, hiện khi đã chọn chi nhánh) -->
    <div id="branchInfoBar" class="branch-info-bar">
        <span class="branch-info-bar__icon">📍</span>
        <div class="branch-info-bar__body">
            <span class="branch-info-bar__label">Đang xem sản phẩm tại</span>
            <strong id="branchInfoName" class="branch-info-bar__name"></strong>
        </div>
        <button id="branchInfoClearBtn" class="branch-info-bar__clear-btn">
            ✕ Bỏ lọc
        </button>
    </div>

    @await Html.PartialAsync("_ProductFilters")

    <div class="products-grid" id="productsGrid">
        @foreach (var product in productList)
        {
            var isDiscountActive = product.MaGiamGiaNavigation != null
                && product.MaGiamGiaNavigation.GiaTri > 0
                && product.MaGiamGiaNavigation.ThoiGianBatDau <= DateTime.Now
                && product.MaGiamGiaNavigation.ThoiGianKetThuc >= DateTime.Now;
            var discountPct  = isDiscountActive ? product.MaGiamGiaNavigation.GiaTri : 0;
            var discountPrice = isDiscountActive
                ? Math.Round((decimal)product.GiaTien - ((decimal)product.GiaTien * discountPct / 100), 0)
                : (decimal)product.GiaTien;
            var categoryName = product.MaDmNavigation?.TenDm ?? "";
            <div class="product-card"
                 data-ma-sp="@product.MaSp"
                 data-price="@product.GiaTien"
                 data-name="@product.TenSp"
                 data-sales="@(product.SlbanTrongNgay ?? 0)"
                 data-discount="@discountPct"
                 data-category="@categoryName">
                <button class="wishlist-heart-btn" data-product-id="@product.MaSp" title="Thêm vào yêu thích" aria-label="Yêu thích">
                    <svg class="heart-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path class="heart-path" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                </button>
                <div class="product-image-wrapper">
                    <img src="@Url.Content(product.HinhAnh1)" class="product-image" alt="@product.TenSp"
                         onerror="this.src='/images/logo.jpg'" loading="lazy" />
                    @if (isDiscountActive)
                    {
                        <div class="discount-badge">-@discountPct.ToString("0.##")%</div>
                    }
                    @if (!string.IsNullOrEmpty(categoryName))
                    {
                        <span class="product-category-tag">@categoryName</span>
                    }
                    <div class="product-overlay">
                        <a href="@Url.Action("ChiTietSanPham", "SanPhams", new { id = product.MaSp })" class="btn-view-detail">Xem Chi Tiết</a>
                    </div>
                </div>
                <div class="product-info">
                    <h3 class="product-name">@product.TenSp</h3>
                    @if (isDiscountActive)
                    {
                        <div class="product-price-block">
                            <span class="product-price-sale">@discountPrice.ToString("N0") đ</span>
                            <span class="product-price-original">@String.Format("{0:0,0} đ", product.GiaTien)</span>
                        </div>
                    }
                    else
                    {
                        <p class="product-price">@discountPrice.ToString("N0") đ</p>
                    }
                    @if (!string.IsNullOrEmpty(product.ThanhPhan))
                    {
                        <p class="product-ingredient"><strong>Nguyên liệu:</strong> @product.ThanhPhan</p>
                    }
                    <div class="product-card-divider"></div>
                    <button class="btn-buy"
                            data-ma-sp="@product.MaSp"
                            data-img="@(product.HinhAnh1 ?? product.HinhAnh2 ?? "/images/logo.jpg")"
                            aria-label="Thêm @product.TenSp vào giỏ hàng">
                        🛒 Thêm vào giỏ hàng
                    </button>
                </div>
            </div>
        }
    </div>
</div>

