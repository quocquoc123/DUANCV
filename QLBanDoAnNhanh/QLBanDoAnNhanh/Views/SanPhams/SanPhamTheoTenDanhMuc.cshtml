@model IEnumerable<QLBanDoAnNhanh.Models.SanPham>

@{
    ViewData["Title"] = "Sản phẩm theo danh mục: " + ViewBag.TenDanhMuc;
    var tenDanhMuc = ViewBag.TenDanhMuc as string ?? "";
    var displayNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["THUCDON"] = "Thực Đơn",
        ["NUOCUONG"] = "Nước Uống",
        ["BESTSELLER"] = "Best Seller",
        ["KHUYENMAI"] = "Khuyến Mãi",
        ["DOANCAY"] = "Đồ Ăn Cay",
        ["BURGER"] = "Burger",
        ["GARAN"] = "Gà Rán",
        ["GÀ RÁN"] = "Gà Rán",
        ["COMBO"] = "Combo"
    };
    var categoryDescriptions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["THUCDON"] = "Burger, cơm, mì ý và các món chính thơm ngon mỗi ngày",
        ["NUOCUONG"] = "Giải khát cùng trà, nước ngọt và đồ uống mát lạnh",
        ["BESTSELLER"] = "Những món được khách hàng yêu thích và đặt nhiều nhất",
        ["KHUYENMAI"] = "Ưu đãi hấp dẫn — thưởng thức ngon với giá tốt",
        ["DOANCAY"] = "Hương vị cay nồng đậm đà dành cho tín đồ món cay",
        ["BURGER"] = "Burger béo ngậy, thơm lừng — giao nhanh tận tay",
        ["GARAN"] = "Gà rán giòn rụm, vàng ươm — ăn là mê",
        ["COMBO"] = "Combo tiết kiệm — đủ món, no nê cả nhà"
    };
    var categoryTitle = displayNames.TryGetValue(tenDanhMuc, out var name) ? name : tenDanhMuc;
    var categoryDesc = categoryDescriptions.TryGetValue(tenDanhMuc, out var desc)
        ? desc
        : $"Khám phá các món ngon trong danh mục {categoryTitle}";
    var productList = Model?.ToList() ?? new List<QLBanDoAnNhanh.Models.SanPham>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/foodfast-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/foodfast-category.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/foodfast-search.css" asp-append-version="true" />
}

<div class="category-page">
    <!-- Hero — cùng cấu trúc Trang Chủ -->
    <div class="home-hero-band">
        <div class="hero-section category-hero-section">
            <div class="hero-background"></div>

            <div class="hero-visual hero-visual-left">
                <img src="@Url.Content("~/images/Burger-Flava.jpg")" alt="" class="hero-food-img hero-img-1">
                <img src="@Url.Content("~/images/D-CBO-Bucket-2.jpg")" alt="" class="hero-food-img hero-img-2">
                <img src="@Url.Content("~/images/P4-OR.jpg")" alt="" class="hero-food-img hero-img-3">
            </div>

            <div class="hero-content">
                <h1 class="hero-title">Danh mục</h1>
                <h2 class="hero-subtitle category-hero-name">@categoryTitle</h2>
                <p class="hero-description">@categoryDesc</p>
                @if (productList.Count > 0)
                {
                    <span class="category-count">@productList.Count sản phẩm</span>
                }
                <a href="#category-products" class="hero-btn">Xem Sản Phẩm</a>
            </div>

            <div class="hero-visual hero-visual-right">
                <img src="@Url.Content("~/images/MI-Y-GA-VIEN.jpg")" alt="" class="hero-food-img hero-img-4">
                <img src="@Url.Content("~/images/COM.jpg")" alt="" class="hero-food-img hero-img-5">
                <img src="@Url.Content("~/images/MON AN NHE.jpg")" alt="" class="hero-food-img hero-img-6">
            </div>
        </div>
    </div>

    <!-- Promo — giống Trang Chủ -->
    <div class="promo-section">
        <div class="promo-box">
            <i class="icon">⚡</i>
            <h3>Giao Hàng Nhanh</h3>
            <p>Giao trong 30 phút</p>
        </div>
        <div class="promo-box">
            <i class="icon">✓</i>
            <h3>Chất Lượng Đảm Bảo</h3>
            <p>100% sản phẩm tươi mới</p>
        </div>
        <div class="promo-box">
            <i class="icon">💳</i>
            <h3>Thanh Toán Dễ Dàng</h3>
            <p>Nhiều phương thức thanh toán</p>
        </div>
        <div class="promo-box">
            <i class="icon">👥</i>
            <h3>Hỗ Trợ 24/7</h3>
            <p>Luôn sẵn sàng phục vụ</p>
        </div>
    </div>

    <!-- Products — giống Trang Chủ -->
    <div id="category-products" class="products-container" data-ff-catalog data-ff-search-term="">
        <div class="section-header">
            <h2>@categoryTitle</h2>
            <p>@categoryDesc</p>
        </div>

        @if (productList.Count > 0)
        {
            @await Html.PartialAsync("_ProductFilters")

            <div class="products-grid">
                @foreach (var product in productList)
                {
                    var discountPct = product.MaGiamGiaNavigation != null && product.MaGiamGiaNavigation.ThoiGianKetThuc >= DateTime.Now
                        ? product.MaGiamGiaNavigation.GiaTri : 0;
                    var categoryCode = product.MaDmNavigation?.TenDm ?? tenDanhMuc;
                    <div class="product-card"
                         data-ma-sp="@product.MaSp"
                         data-price="@product.GiaTien"
                         data-name="@product.TenSp"
                         data-sales="@(product.SlbanTrongNgay ?? 0)"
                         data-discount="@discountPct"
                         data-category="@categoryCode">
                        <div class="product-image-wrapper">
                            <img src="@Url.Content(product.HinhAnh1)" class="product-image" alt="@product.TenSp" />
                            @if (product.MaGiamGiaNavigation != null && product.MaGiamGiaNavigation.ThoiGianKetThuc >= DateTime.Now)
                            {
                                <div class="discount-badge">-@product.MaGiamGiaNavigation.GiaTri%</div>
                            }
                            <div class="product-overlay">
                                <a href="@Url.Action("ChiTietSanPham", "SanPhams", new { id = product.MaSp })" class="btn-view-detail">Xem Chi Tiết</a>
                            </div>
                        </div>
                        <div class="product-info">
                            <h3 class="product-name">@product.TenSp</h3>
                            <p class="product-price">@product.GiaTien.ToString("C") VND</p>
                            <div class="product-description">
                                <p><strong>Thành phần:</strong> @product.ThanhPhan</p>
                                <p><strong>Bán:</strong> @product.SlbanTrongNgay</p>
                            </div>
                            <a href="@Url.Action("ChiTietSanPham", "SanPhams", new { id = product.MaSp })" class="btn-buy">Mua Ngay</a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="category-empty">
                <div class="category-empty-icon">🍽️</div>
                <h3>Chưa có sản phẩm</h3>
                <p>Danh mục @categoryTitle hiện chưa có sản phẩm nào.</p>
                <a href="@Url.Action("TrangChu", "SanPhams")" class="btn-back">Về Trang Chủ</a>
            </div>
        }
    </div>
</div>

<script src="~/js/foodfast-catalog.js" asp-append-version="true"></script>
