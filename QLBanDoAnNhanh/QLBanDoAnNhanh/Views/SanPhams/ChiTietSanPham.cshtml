@model QLBanDoAnNhanh.Models.SanPham

@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm";
    var binhLuans = ViewBag.BinhLuans as List<QLBanDoAnNhanh.Models.BinhLuan>;
    var diemTrungBinh = (double)(ViewBag.DiemTrungBinh ?? 0);
    var isDiscountActive = (bool)(ViewBag.IsDiscountActive ?? false);
    var effectivePrice = (decimal)(ViewBag.EffectivePrice ?? (decimal)Model.GiaTien);
    var discountPercent = Model.MaGiamGiaNavigation?.GiaTri ?? 0;
    var savedAmount = Math.Max(0, (decimal)Model.GiaTien - effectivePrice);
    var canComment = (bool)(ViewBag.CanComment ?? false);
    var hasPurchasedProduct = (bool)(ViewBag.HasPurchasedProduct ?? false);
    var hasCommentedProduct = (bool)(ViewBag.HasCommentedProduct ?? false);
    var ratingCounts = ViewBag.RatingCounts as int[] ?? new int[6];
    var userRatings = ViewBag.UserRatings as Dictionary<int, int> ?? new Dictionary<int, int>();
    var totalRatings = ratingCounts.Skip(1).Take(5).Sum();
}

@section Styles {
    <link rel="stylesheet" href="~/css/foodfast-product-detail.css" asp-append-version="true" />
    <style>
        /* Badge hết hàng trên ảnh chi tiết */
        .detail-oos-badge {
            position: absolute;
            bottom: 12px; left: 12px;
            background: rgba(30,30,30,0.82);
            color: #fff;
            font-weight: 800;
            font-size: 13px;
            padding: 6px 14px;
            border-radius: 10px;
            z-index: 10;
            letter-spacing: 0.5px;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255,255,255,0.15);
            pointer-events: none;
        }
        /* Nút khi hết hàng */
        .btn-oos-disabled {
            background: linear-gradient(135deg, #aaa, #888) !important;
            cursor: not-allowed !important;
            opacity: 0.75;
            box-shadow: none !important;
            pointer-events: none;
        }
        .qty-stepper.oos-disabled button,
        .qty-stepper.oos-disabled input {
            opacity: 0.5;
            pointer-events: none;
            cursor: not-allowed;
        }
    </style>
}

<div class="product-detail-page">
    <div class="product-detail-header">
        <h1>Chi Tiết Sản Phẩm</h1>
    </div>

    <div class="product-container">
        <div class="col-5 product-image-card">
            <div class="product-image-wrapper product-img-hover-wrap">
                @{
                    var img2 = string.IsNullOrEmpty(Model.HinhAnh2) ? Model.HinhAnh1 : Model.HinhAnh2;
                }
                <!-- Ảnh 1: hiển thị mặc định -->
                <img class="product-image product-img-primary" id="ff-detail-product-img"
                     src="@Url.Content(Model.HinhAnh1)" alt="@Model.TenSp"
                     onerror="this.src='/images/logo.jpg'" />
                <!-- Ảnh 2: hiện khi hover -->
                <img class="product-image product-img-secondary"
                     src="@Url.Content(img2)" alt="@Model.TenSp - ảnh 2"
                     onerror="this.src='/images/logo.jpg'" aria-hidden="true" />

            </div>
            @if (Model.HetHang)
            {
                <span class="detail-oos-badge">🚫 Hết hàng</span>
            }
            <div class="product-image-meta product-image-rating">
                <div class="product-image-rating__label">Đánh giá sản phẩm</div>
                <div class="product-image-rating__score-row">
                    <span class="product-image-rating__score">@diemTrungBinh.ToString("0.0")</span>
                    <div class="product-image-rating__stars" aria-label="Đánh giá trung bình @diemTrungBinh.ToString("0.0") trên 5 sao">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <span class="product-image-rating__star @(s <= Math.Round(diemTrungBinh) ? "is-filled" : "")">&#9733;</span>
                        }
                    </div>
                </div>
                <div class="product-image-rating__caption">
                    @if (totalRatings > 0)
                    {
                        <text>@totalRatings lượt đánh giá</text>
                    }
                    else
                    {
                        <text>Chưa có đánh giá</text>
                    }
                </div>
            </div>
        </div>

        <div class="col-7 product-details">
            <div class="product-info-card">
                <div class="product-info-row">
                    <span class="label">Tên Sản Phẩm:</span>
                    <span class="value">@Model.TenSp</span>
                </div>
                <div class="product-info-row">
                    <span class="label">Giá:</span>
                    <span class="value price">
                        @if (isDiscountActive)
                        {
                            <span class="detail-discount-badge">-@discountPercent.ToString("0.##")%</span>
                            <span class="detail-original-price">@String.Format("{0:0,0} đ", Model.GiaTien)</span>
                            <span class="detail-sale-price">@effectivePrice.ToString("N0") đ</span>
                            <span class="detail-saving">Bạn tiết kiệm @savedAmount.ToString("N0") đ</span>
                        }
                        else
                        {
                            @String.Format("{0:0,0} đ", Model.GiaTien)
                        }
                    </span>
                </div>
                <div class="product-info-row">
                    <span class="label">Thành Phần:</span>
                    <span class="value">@Model.ThanhPhan</span>
                </div>
                <div class="product-info-row">
                    <span class="label">Số Lượng Bán Trong Ngày:</span>
                    <span class="value">@Model.SlbanTrongNgay</span>
                </div>
                <div class="product-info-row">
                    <span class="label">Chi Tiết Sản Phẩm:</span>
                    <span class="value">@Model.ChitietSp</span>
                </div>
            </div>

            <div id="muaNgayForm">
                @if (Model.HetHang)
                {
                    <div style="background:linear-gradient(135deg,#fff3f3,#ffeaea); border:1.5px solid #ffcccc; border-radius:12px; padding:14px 18px; margin-bottom:16px; display:flex; align-items:center; gap:10px;">
                        <span style="font-size:22px;">🚫</span>
                        <div>
                            <strong style="color:#cc0000; font-size:0.95rem;">Sản phẩm hiện đã hết hàng</strong>
                            <p style="margin:2px 0 0; color:#888; font-size:0.82rem;">Vui lòng quay lại sau hoặc xem các sản phẩm khác.</p>
                        </div>
                    </div>
                }
                <label for="quantity">Số Lượng:</label>
                <div class="qty-stepper @(Model.HetHang ? "oos-disabled" : "")">
                    <button type="button" class="qty-btn qty-minus" aria-label="Giảm số lượng" @(Model.HetHang ? "disabled" : "") onclick="var q=document.getElementById('quantity');var v=parseInt(q.value)||1;if(v>1)q.value=v-1;">&#x2212;</button>
                    <input type="number" id="quantity" name="quantity" min="1" value="1" @(Model.HetHang ? "disabled" : "") />
                    <button type="button" class="qty-btn qty-plus" aria-label="Tăng số lượng" @(Model.HetHang ? "disabled" : "") onclick="document.getElementById('quantity').stepUp();">+</button>
                </div>
                <button type="button" id="muaNgayButton"
                        class="btn btn-primary @(Model.HetHang ? "btn-oos-disabled" : "")"
                        @(Model.HetHang ? "disabled" : "")
                        onclick="@(Model.HetHang ? "" : "chiTietAddToCart()")">
                    @(Model.HetHang ? "🚫 Sản phẩm đã hết hàng" : "🛒 Thêm vào giỏ hàng")
                </button>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="MoTaDanhGia ff-reviews" data-ff-ready="false">
        <div class="ff-rating-summary-card">
            <div class="ff-rating-summary-grid">
                <div class="ff-rating-left">
                    <div class="ff-rating-score">@diemTrungBinh.ToString("0.0")</div>
                    <div class="ff-rating-stars" aria-label="Average rating @diemTrungBinh.ToString("0.0") out of 5">
                        @for (int s = 1; s <= 5; s++)
                        {
                            <span class="ff-star @(s <= Math.Round(diemTrungBinh) ? "is-filled" : "")">&#9733;</span>
                        }
                    </div>
                    <div class="ff-rating-caption">Average Rating</div>
                    <div class="ff-rating-subcaption">
                        @if (totalRatings > 0)
                        {
                            <text>@totalRatings lượt đánh giá</text>
                        }
                        else
                        {
                            <text>Chưa có đánh giá</text>
                        }
                    </div>
                </div>

                <div class="ff-rating-right" aria-label="Rating distribution">
                    @for (int star = 5; star >= 1; star--)
                    {
                        var count = ratingCounts.Length > star ? ratingCounts[star] : 0;
                        var pct = totalRatings > 0 ? (int)Math.Round((count * 100.0) / totalRatings) : 0;
                        <div class="ff-rating-bar">
                            <div class="ff-rating-bar__label">
                                <span class="ff-rating-bar__star">@star</span>
                                <span class="ff-rating-bar__icon">&#9733;</span>
                            </div>
                            <div class="ff-rating-bar__track" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                <div class="ff-rating-bar__fill" style="--ff-fill:@pct%"></div>
                            </div>
                            <div class="ff-rating-bar__value">@count</div>
                        </div>
                    }

                    @if (totalRatings == 0)
                    {
                        <div class="ff-empty-inline">
                            Chưa có dữ liệu thống kê sao.
                        </div>
                    }
                </div>
            </div>

            <div class="ff-rating-actions">
                <div class="rating-form-wrap">
                    <form asp-action="AddAndUpdateRating" asp-controller="SanPhams" method="post">
                        <input type="hidden" name="maSP" value="@Model.MaSp" />

                        <label for="rating">Chọn số sao:</label>
                        <div class="rating">
                            <input type="radio" name="rating" id="star5" value="5" />
                            <label for="star5" class="star">&#9733;</label>

                            <input type="radio" name="rating" id="star4" value="4" />
                            <label for="star4" class="star">&#9733;</label>

                            <input type="radio" name="rating" id="star3" value="3" />
                            <label for="star3" class="star">&#9733;</label>

                            <input type="radio" name="rating" id="star2" value="2" />
                            <label for="star2" class="star">&#9733;</label>

                            <input type="radio" name="rating" id="star1" value="1" />
                            <label for="star1" class="star">&#9733;</label>
                        </div>

                        <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
                    </form>
                </div>
            </div>

            <div class="ff-skeleton" aria-hidden="true">
                <div class="ff-skeleton-line w-60"></div>
                <div class="ff-skeleton-line w-40"></div>
                <div class="ff-skeleton-line w-80"></div>
            </div>
        </div>

        <div class="ff-review-list-card">
            <div class="ff-review-list-header">
                <h3>Bình luận</h3>
                <span class="ff-review-count">@(binhLuans?.Count ?? 0) review</span>
            </div>
            @if (binhLuans != null && binhLuans.Count > 0)
            {
                <div id="binhLuanContainer">
                    @for (int i = 0; i < binhLuans.Count && i < 5; i++)
                    {
                        var displayName = string.IsNullOrWhiteSpace(binhLuans[i].MaNguoiDungNavigation?.HoTen)
                            ? binhLuans[i].MaNguoiDungNavigation?.Username
                            : binhLuans[i].MaNguoiDungNavigation?.HoTen;
                        var avatarName = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName.Trim().Substring(0, 1).ToUpper();
                        var showRating = userRatings.TryGetValue(binhLuans[i].MaNguoiDung, out var r) ? r : 0;
                        <div class="binhLuanItem">
                            <div class="ff-review-card">
                                <div class="ff-review-avatar">@avatarName</div>
                                <div class="ff-review-main">
                                    <div class="ff-review-top">
                                        <div class="ff-review-user">
                                            <strong class="ff-review-name">@(displayName ?? "Người dùng")</strong>
                                            <small class="ff-review-time">@binhLuans[i].NgayBinhLuan.ToString("dd/MM/yyyy HH:mm:ss")</small>
                                        </div>
                                        @if (showRating > 0)
                                        {
                                            <div class="ff-review-rating" aria-label="@showRating stars">
                                                <span class="ff-review-rating__score">@showRating</span>
                                                <span class="ff-review-rating__star">&#9733;</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="ff-review-content">@binhLuans[i].NoiDung</div>
                                </div>
                            </div>
                        </div>
                    }

                    <div id="hiddenComments" style="display: none;">
                        @for (int i = 5; i < binhLuans.Count; i++)
                        {
                            var displayName = string.IsNullOrWhiteSpace(binhLuans[i].MaNguoiDungNavigation?.HoTen)
                                ? binhLuans[i].MaNguoiDungNavigation?.Username
                                : binhLuans[i].MaNguoiDungNavigation?.HoTen;
                            var avatarName = string.IsNullOrWhiteSpace(displayName) ? "U" : displayName.Trim().Substring(0, 1).ToUpper();
                            var showRating = userRatings.TryGetValue(binhLuans[i].MaNguoiDung, out var r) ? r : 0;
                            <div class="binhLuanItem">
                                <div class="ff-review-card">
                                    <div class="ff-review-avatar">@avatarName</div>
                                    <div class="ff-review-main">
                                        <div class="ff-review-top">
                                            <div class="ff-review-user">
                                                <strong class="ff-review-name">@(displayName ?? "Người dùng")</strong>
                                                <small class="ff-review-time">@binhLuans[i].NgayBinhLuan.ToString("dd/MM/yyyy HH:mm:ss")</small>
                                            </div>
                                            @if (showRating > 0)
                                            {
                                                <div class="ff-review-rating" aria-label="@showRating stars">
                                                    <span class="ff-review-rating__score">@showRating</span>
                                                    <span class="ff-review-rating__star">&#9733;</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="ff-review-content">@binhLuans[i].NoiDung</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (binhLuans.Count > 5)
                {
                    <button id="xemThemButton" class="btn btn-secondary" onclick="showAllComments()">Xem thêm</button>
                }
            }
            else
            {
                <div class="ff-empty-review">
                    <div class="ff-empty-review__title">Chưa có bình luận nào</div>
                    <div class="ff-empty-review__subtitle">Hãy là người đầu tiên chia sẻ trải nghiệm của bạn.</div>
                </div>
            }
        </div>

        <div class="comment-form-card">
            <h4>Gửi Bình Luận</h4>
            @if (Context.Session.GetString("userLogin") == null)
            {
                <p class="comments-empty">Vui lòng đăng nhập để bình luận.</p>
            }
            else if (!hasPurchasedProduct)
            {
                <p class="comments-empty">Bạn cần mua sản phẩm này trước khi bình luận.</p>
            }
            else if (hasCommentedProduct)
            {
                <p class="comments-empty">Bạn đã bình luận sản phẩm này rồi.</p>
            }
            else if (canComment)
            {
                @using (Html.BeginForm("AddComment", "SanPhams", FormMethod.Post))
                {
                    @Html.Hidden("maSP", Model.MaSp)
                    <div class="form-group">
                        <label for="NoiDung">Nội dung</label>
                        <textarea name="noiDung" id="NoiDung" class="form-control" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Gửi bình luận</button>
                }
            }
        </div>
    </div>
</div>

<script>
    window.onload = function () {
        var alertBox = document.querySelector('.alert');
        if (alertBox) {
            alertBox.classList.add('show-alert');
            setTimeout(function () {
                alertBox.classList.remove('show-alert');
            }, 2000);
        }
    };

    function showAllComments() {
        document.getElementById("hiddenComments").style.display = "block";
        document.getElementById("xemThemButton").style.display = "none";
    }

    document.addEventListener('DOMContentLoaded', function () {
        var wrap = document.querySelector('.ff-reviews');
        if (wrap) {
            wrap.setAttribute('data-ff-ready', 'true');
        }
    });

    // ---- AJAX Add to Cart cho trang Chi Tiết ----
    function chiTietAddToCart() {
        var maSp    = @Model.MaSp;
        var qty     = parseInt(document.getElementById('quantity').value, 10) || 1;
        var imgEl   = document.getElementById('ff-detail-product-img');
        var btnEl   = document.getElementById('muaNgayButton');

        if (window.FoodFast && FoodFast.addToCart) {
            FoodFast.addToCart(maSp, qty, imgEl, btnEl);
        }
    }
</script>
