@model IEnumerable<QLBanDoAnNhanh.Models.SanPham>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_LayouAdmin.cshtml";
}
<div id="notification-container"style="text-align:center;">
    @if (TempData["DeleteError"] != null)
    {
        <div class="alert alert-danger" id="alert-message">
            @TempData["DeleteError"]
        </div>
    }

    @if (TempData["DeleteSuccess"] != null)
    {
        <div class="alert alert-success" id="alert-message">
            @TempData["DeleteSuccess"]
        </div>
    }
</div>

<script>
    // Tự động ẩn thông báo sau 5 giây (5000ms)
    setTimeout(function () {
        var alertBox = document.getElementById("alert-message");
        if (alertBox) {
            alertBox.style.transition = "opacity 0.5s ease-out";
            alertBox.style.opacity = "0";
            setTimeout(() => alertBox.remove(), 500);
        }
    }, 5000);
</script>
<h1>Quản lý sản phẩm</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Tạo sản phẩm</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenSp)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThanhPhan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GiaTien)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DonVi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChitietSp)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SlbanTrongNgay)
            </th>
            <th>Hình ảnh 1</th>
            <th>Hình ảnh 2</th>
            <th>
                @Html.DisplayNameFor(model => model.MaDmNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaGiamGiaNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TenSp)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ThanhPhan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GiaTien)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DonVi)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChitietSp)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SlbanTrongNgay)
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.HinhAnh1))
                    {
                            <img src="@item.HinhAnh1" alt="Hình ảnh sản phẩm 1" style="width: 100px; height: auto;" />
                    }
                    else
                    {
                            <span>Không có hình ảnh</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.HinhAnh2))
                    {
                            <img src="@item.HinhAnh2" alt="Hình ảnh sản phẩm 2" style="width: 100px; height: auto;" />
                    }
                    else
                    {
                            <span>Không có hình ảnh</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaDmNavigation.MaDm)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaGiamGiaNavigation.MaGiamGia)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MaSp">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.MaSp">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.MaSp">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<style>
    /* CSS tổng thể */


    /* Tiêu đề */
    h1 {
        text-align: center;
        margin-bottom: 30px;
        color: #333;
    }

    /* Form lọc */
    form {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    label {
        font-weight: bold;
        margin-bottom: 10px;
    }

    .form-select {
        width: 100%;
        max-width: 300px;
        margin-bottom: 10px;
    }

    button[type="submit"] {
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 10px 20px;
        transition: background-color 0.3s;
        cursor: pointer;
    }

        button[type="submit"]:hover {
            background-color: #0056b3;
        }

    /* Bảng danh sách đơn hàng */
    .table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

        .table thead tr {
            background-color: #007bff;
            color: white;
            text-align: left;
        }

        .table th,
        .table td {
            padding: 12px 15px;
            border-bottom: 1px solid #ddd;
        }

        .table tbody tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .table tbody tr:hover {
            background-color: #e9ecef;
        }

    /* Các nút hành động */
    .btn {
        padding: 5px 10px;
        border-radius: 5px;
        margin-right: 5px;
        text-decoration: none;
        color: white;
        transition: background-color 0.3s;
    }

    .btn-warning {
        background-color: #ffc107;
    }

        .btn-warning:hover {
            background-color: #e0a800;
        }

    .btn-info {
        background-color: #17a2b8;
    }

        .btn-info:hover {
            background-color: #138496;
        }

    .btn-danger {
        background-color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

</style>
