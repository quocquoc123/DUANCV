@model IEnumerable<QLBanDoAnNhanh.Models.SanPham>

@{
    ViewData["Title"] = "Trang Chủ";
    var heroLeftImage = ViewBag.HeroLeftImage as string ?? "/images/Burger-Zinger.jpg";
    var heroLeftAlt = ViewBag.HeroLeftAlt as string ?? "Burger Zinger";
    var heroRightImage = ViewBag.HeroRightImage as string ?? "/images/Burger-Flava.jpg";
    var heroRightAlt = ViewBag.HeroRightAlt as string ?? "Burger Flava";
}

@section Styles {
    <link rel="stylesheet" href="~/css/foodfast-home.css" asp-append-version="true" />
}

<!-- Hero Section -->
<div class="home-hero-band">
<div class="hero-section">
    <div class="hero-background"></div>
    <partial name="_HeroDecorPartial" />

    <!-- Ảnh món ăn bên trái -->
    <div class="hero-visual hero-visual-left">
        <img src="@heroLeftImage" class="hero-food-img" alt="@heroLeftAlt" />
    </div>

    <div class="hero-content">
        <h1 class="hero-title">Chào mừng bạn đến với</h1>
        <h2 class="hero-subtitle">Food Fast</h2>
        <p class="hero-description">Thực phẩm tươi ngon, giao nhanh và tiện lợi mỗi ngày.</p>

        <a href="#products-section" class="hero-btn">
            Khám Phá Ngay <span class="hero-btn-arrow">→</span>
        </a>
    </div>

    <!-- Ảnh món ăn bên phải -->
    <div class="hero-visual hero-visual-right">
        <img src="@heroRightImage" class="hero-food-img" alt="@heroRightAlt" />
    </div>
</div>
</div>

<!-- Promo Section -->
<div class="promo-section">
    <div class="promo-box promo-box-1">
        <i class="icon">⚡</i>
        <h3>Giao Hàng Nhanh</h3>
        <p>Giao trong 30 phút</p>
    </div>
    <div class="promo-box promo-box-2">
        <i class="icon">✓</i>
        <h3>Chất Lượng Đảm Bảo</h3>
        <p>100% sản phẩm tươi mới</p>
    </div>
    <div class="promo-box promo-box-3">
        <i class="icon">💳</i>
        <h3>Thanh Toán Dễ Dàng</h3>
        <p>Nhiều phương thức thanh toán</p>
    </div>
    <div class="promo-box promo-box-4">
        <i class="icon">👥</i>
        <h3>Hỗ Trợ 24/7</h3>
        <p>Luôn sẵn sàng phục vụ</p>
    </div>
</div>

<!-- Products Section -->
<div id="products-section" class="products-container">
    <div class="section-header">
        <h2>Danh Sách Sản Phẩm Nổi Bật</h2>
        <p>Những món ăn được yêu thích nhất của chúng tôi</p>
    </div>

    <div class="products-grid">
        @foreach (var product in Model)
        {
            <div class="product-card" data-product-card>
                <!-- Wishlist heart button – outside image-wrapper to avoid overflow:hidden clipping -->
                <button class="wishlist-heart-btn" data-product-id="@product.MaSp" title="Thêm vào yêu thích" aria-label="Yêu thích">
                    <svg class="heart-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path class="heart-path" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                </button>
                <div class="product-image-wrapper">
                    <img src="@Url.Content(product.HinhAnh1)" class="product-image" alt="@product.TenSp" />
                    <div class="product-overlay">
                        <a href="@Url.Action("ChiTietSanPham", "SanPhams", new { id = product.MaSp })" class="btn-view-detail">Xem Chi Tiết</a>
                    </div>
                    @{
                        var homeCatName = product.MaDmNavigation?.TenDm ?? "";
                    }
                    @if (!string.IsNullOrEmpty(homeCatName))
                    {
                        <span class="product-category-tag">@homeCatName</span>
                    }
                </div>
                <div class="product-info">
                    <h3 class="product-name">@product.TenSp</h3>
                    <p class="product-price">@product.GiaTien.ToString("C") VND</p>
                    <div class="product-description">
                        <p><strong>Thành phần:</strong> @product.ThanhPhan</p>
                        <p><strong>Bán:</strong> @product.SlbanTrongNgay</p>
                    </div>
                    <button class="btn-buy"
                            data-ma-sp="@product.MaSp"
                            data-img="@Url.Content(product.HinhAnh1)"
                            aria-label="Thêm @product.TenSp vào giỏ hàng">
                        🛒 Thêm vào giỏ hàng
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
(function () {
    // Load wishlist states on page load
    async function loadWishlistStates() {
        const btns = document.querySelectorAll('.wishlist-heart-btn');
        btns.forEach(async (btn) => {
            const pid = btn.dataset.productId;
            try {
                const res = await fetch(`/Wishlist/Check/${pid}`);
                const data = await res.json();
                if (data.isWishlisted) {
                    btn.classList.add('active');
                }
            } catch (_) { /* guest user – ignore */ }
        });
    }

    // Toggle wishlist on click
    document.querySelectorAll('.wishlist-heart-btn').forEach(btn => {
        btn.addEventListener('click', async function (e) {
            e.preventDefault();
            e.stopPropagation();

            const pid = this.dataset.productId;
            const token = document.querySelector('input[name="__RequestVerificationToken"]');

            try {
                const res = await fetch(`/Wishlist/Toggle/${pid}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        ...(token ? { 'RequestVerificationToken': token.value } : {})
                    }
                });
                const data = await res.json();

                if (data.requireLogin) {
                    // Redirect to login
                    window.location.href = '/User/Login';
                    return;
                }

                if (data.success) {
                    // Toggle active class
                    this.classList.toggle('active', data.isWishlisted);
                    // Pop animation
                    this.classList.add('pop');
                    this.addEventListener('animationend', () => this.classList.remove('pop'), { once: true });

                    // Update wishlist counter in navbar if it exists
                    const counter = document.querySelector('.wishlist-count, #wishlist-count');
                    if (counter && data.count !== undefined) {
                        counter.textContent = data.count;
                        counter.style.display = data.count > 0 ? '' : 'none';
                    }
                }
            } catch (err) {
                console.error('Wishlist toggle error:', err);
            }
        });
    });

    loadWishlistStates();
})();
</script>
}
