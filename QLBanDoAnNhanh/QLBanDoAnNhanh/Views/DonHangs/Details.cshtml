@model QLBanDoAnNhanh.Models.DonHang

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_LayouAdmin.cshtml";
    var thanhToan = Model.ThanhToans?.FirstOrDefault();
    var phuongThucThanhToan = string.IsNullOrWhiteSpace(thanhToan?.PhuongThucThanhToan)
        ? "Chưa có thông tin"
        : thanhToan.PhuongThucThanhToan;
}
<h2>Chi Tiết Đơn Hàng</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Mã Đơn Hàng:</strong> @Model.MaDh</p>
        <p><strong>Người Đặt:</strong> @Model.Username</p>
        <p><strong>Địa Chỉ:</strong> @Model.Diachi</p>
        <p><strong>Phương Thức Thanh Toán:</strong> @phuongThucThanhToan</p>
        <p><strong>Tổng Tiền:</strong> @Model.TongTien.ToString("N0") VND</p>
        <p><strong>Số Lượng Sản Phẩm:</strong> @Model.SoLuong</p>
        <p><strong>Trạng Thái:</strong> @Model.TrangThai</p>
        <p><strong>Ngày Tạo:</strong> @Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Ngày Cập Nhật:</strong> @Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</p>

        <a class="btn btn-primary" asp-action="Index">Quay lại danh sách</a>

    </div>
    @if (Model.TrangThai == "Đã Giao")
{
    <a href="@Url.Action("ExportInvoiceToPdf", "DonHangs", new { maDh = Model.MaDh })" class="btn btn-custom">
        Xuất hóa đơn
    </a>
}
</div>
<style>
        .btn-custom {
            background-color: #007bff; 
            border: none; 
            color: white; 
            padding: 10px 20px; 
            text-align: center;
            text-decoration: none;
            display: inline-block; 
            font-size: 16px; 
            border-radius: 5px;
            transition: background-color 0.3s, transform 0.3s; 
        }

            .btn-custom:hover {
                background-color: #0056b3;
               
            }

           
</style>
