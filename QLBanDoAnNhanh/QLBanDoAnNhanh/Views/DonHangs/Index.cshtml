@model IEnumerable<QLBanDoAnNhanh.Models.DonHang>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
    Layout = "~/Views/Shared/_LayouAdmin.cshtml";

    var trangThaiOptions = new List<string> { "Chưa Giao", "Đang Giao", "Đã Giao", "Đã Hủy" };
}

<h1>Danh sách đơn hàng</h1>

<!-- Form lọc theo trạng thái bằng radio buttons -->
<form method="get" asp-action="Index" class="mb-3">
    <div class="row">
        <div class="col-md-12">
            <label for="trangThai">Lọc theo trạng thái:</label>
            <select class="form-select" id="trangThai" name="trangThai">
                @* Option cho tất cả trạng thái *@
                @if (ViewBag.TrangThai == null)
                {
                    <option value="" selected>Tất cả</option>
                }
                else
                {
                    <option value="">Tất cả</option>
                }

                @* Các option theo trạng thái *@
                @foreach (var option in trangThaiOptions)
                {
                    if (option == (string)ViewBag.TrangThai)
                    {
                        <option value="@option" selected>@option</option>
                    }
                    else
                    {
                        <option value="@option">@option</option>
                    }
                }
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Lọc</button>
</form>


<table class="table table-striped mt-4">
    <thead>
        <tr>
            <th>Tên</th>
            <th>Địa Chỉ</th>
            <th>Tổng tiền</th>
            <th>Số lượng</th>
            <th>Số điện thoại</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
            <th>Ngày cập nhật</th>
            <th>Mã khuyến mãi</th>
            <th>Mã người dùng</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Username)</td>
                <td>@Html.DisplayFor(modelItem => item.Diachi)</td>
                <td>@string.Format("{0:C}", item.TongTien)</td>
                <td>@Html.DisplayFor(modelItem => item.SoLuong)</td>
                <td>0352385133</td>
                <td>@Html.DisplayFor(modelItem => item.TrangThai)</td>
                <td>@item.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @(item.MaKhuyenMaiNavigation != null ? item.MaKhuyenMaiNavigation.MaKhuyenMai : "Không có")
                </td>
                <td>
                    @(item.MaNguoiDungNavigation != null ? item.MaNguoiDungNavigation.MaNguoiDung : "Không có")
                </td>
             <td>

    <a asp-action="Edit" asp-route-id="@item.MaDh" class="btn btn-sm btn-warning">Sửa</a>
                    
    <a asp-action="Details" asp-route-id="@item.MaDh" class="btn btn-sm btn-info">Chi tiết</a>

    @if (item.TrangThai != "Đã Giao")
    {
        <a asp-action="Delete" asp-route-id="@item.MaDh" class="btn btn-sm btn-danger">Xóa</a>
    }
</td>

            </tr>
        }
    </tbody>
</table>
<style>
    /* CSS tổng thể */
    

    /* Tiêu đề */
    h1 {
        text-align: center;
        margin-bottom: 30px;
        color: #333;
    }

    /* Form lọc */
    form {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    label {
        font-weight: bold;
        margin-bottom: 10px;
    }

    .form-select {
        width: 100%;
        max-width: 300px;
        margin-bottom: 10px;
    }

    button[type="submit"] {
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 10px 20px;
        transition: background-color 0.3s;
        cursor: pointer;
    }

        button[type="submit"]:hover {
            background-color: #0056b3;
        }

    /* Bảng danh sách đơn hàng */
    .table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

        .table thead tr {
            background-color: #007bff;
            color: white;
            text-align: left;
        }

        .table th,
        .table td {
            padding: 12px 15px;
            border-bottom: 1px solid #ddd;
        }

        .table tbody tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        .table tbody tr:hover {
            background-color: #e9ecef;
        }

    /* Các nút hành động */
    .btn {
        padding: 5px 10px;
        border-radius: 5px;
        margin-right: 5px;
        text-decoration: none;
        color: white;
        transition: background-color 0.3s;
    }

    .btn-warning {
        background-color: #ffc107;
    }

        .btn-warning:hover {
            background-color: #e0a800;
        }

    .btn-info {
        background-color: #17a2b8;
    }

        .btn-info:hover {
            background-color: #138496;
        }

    .btn-danger {
        background-color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

</style>